<% content_for(:page_title) { "Feedbacks" } %>

<div class="mx-auto max-w-7xl">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-extrabold text-stone-900 tracking-tight">Feedbacks</h1>
      <p class="text-sm text-stone-500 mt-1"><%= @total_count %> total</p>
    </div>
  </div>

  <!-- Quick Views -->
  <div class="flex flex-wrap gap-2 mb-4">
    <% SavedView::PRESETS.each do |preset| %>
      <%= link_to feedbacks_path(preset[:filters]),
          class: "px-3 py-1.5 rounded-full text-xs font-medium bg-white border border-stone-200 text-stone-600 hover:bg-stone-50 transition-colors" do %>
        <%= preset[:icon] %> <%= preset[:name] %>
      <% end %>
    <% end %>
    <% @saved_views.each do |view| %>
      <span class="inline-flex items-center gap-1">
        <%= link_to feedbacks_path(view.filters),
            class: "px-3 py-1.5 rounded-full text-xs font-medium bg-indigo-50 border border-indigo-200 text-indigo-700 hover:bg-indigo-100 transition-colors" do %>
          <%= view.icon.presence || "📌" %> <%= view.name %>
        <% end %>
        <%= button_to saved_view_path(view), method: :delete, data: { turbo: false },
            class: "text-indigo-300 hover:text-indigo-600 -ml-1" do %>
          <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        <% end %>
      </span>
    <% end %>
  </div>

  <!-- Filter Bar -->
  <div class="bg-white border border-stone-200 rounded-xl p-4 mb-6">
    <%= form_with url: feedbacks_path, method: :get, data: { turbo_frame: "feedbacks_list" }, class: "flex flex-wrap gap-3 items-center" do |f| %>
      <select name="sentiment" class="border border-stone-300 rounded-lg text-[13px] px-3 py-2 text-stone-700 bg-white focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500">
        <option value="">All Sentiments</option>
        <% %w[positive neutral negative].each do |s| %>
          <option value="<%= s %>" <%= "selected" if params[:sentiment] == s %>><%= s.titleize %></option>
        <% end %>
      </select>

      <select name="source_type" class="border border-stone-300 rounded-lg text-[13px] px-3 py-2 text-stone-700 bg-white focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500">
        <option value="">All Sources</option>
        <% current_account.sources.distinct.pluck(:source_type).each do |st| %>
          <option value="<%= st %>" <%= "selected" if params[:source_type] == st %>><%= st.titleize %></option>
        <% end %>
      </select>

      <select name="status" class="border border-stone-300 rounded-lg text-[13px] px-3 py-2 text-stone-700 bg-white focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500">
        <option value="">All Status</option>
        <option value="processed" <%= "selected" if params[:status] == "processed" %>>Processed</option>
        <option value="unprocessed" <%= "selected" if params[:status] == "unprocessed" %>>Unprocessed</option>
      </select>

      <div class="flex-1 min-w-[200px]">
        <input type="text" name="search" value="<%= params[:search] %>" placeholder="Search content..." class="w-full border border-stone-300 rounded-lg text-[13px] px-3 py-2 text-stone-700 placeholder-stone-400 focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500">
      </div>

      <select name="sort" class="border border-stone-300 rounded-lg text-[13px] px-3 py-2 text-stone-700 bg-white focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500">
        <option value="">Sort: Recent</option>
        <option value="priority" <%= "selected" if params[:sort] == "priority" %>>Sort: Priority</option>
      </select>

      <button type="submit" class="px-4 py-2 bg-stone-900 text-white text-[13px] font-medium rounded-lg hover:bg-stone-800 transition-colors">Filter</button>
      <%= link_to "Clear", feedbacks_path, class: "text-stone-700 hover:text-stone-900 underline text-[13px] font-medium" %>
    <% end %>
    <% if params.except(:controller, :action, :page).keys.any? %>
      <details class="mt-3">
        <summary class="text-xs text-stone-500 cursor-pointer hover:text-stone-700">Save this view</summary>
        <div class="mt-2">
          <%= form_with url: saved_views_path, method: :post, data: { turbo: false }, class: "flex gap-2" do |f| %>
            <input type="text" name="saved_view[name]" placeholder="View name..." required
              class="flex-1 px-3 py-1.5 border border-stone-300 rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent">
            <% request.query_parameters.except("page").each do |key, val| %>
              <input type="hidden" name="saved_view[filters][<%= key %>]" value="<%= val %>">
            <% end %>
            <button type="submit" class="px-3 py-1.5 bg-stone-900 text-white text-xs font-medium rounded-lg hover:bg-stone-800 transition-colors">Save</button>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>

  <!-- Feedbacks List -->
  <%= turbo_frame_tag "feedbacks_list" do %>
  <div class="bg-white border border-stone-200 rounded-xl overflow-hidden">
    <div class="divide-y divide-stone-200">
      <% if @feedbacks.any? %>
        <% @feedbacks.each do |feedback| %>
          <%= link_to feedback_path(feedback), class: "block p-5 hover:bg-stone-50 transition-colors" do %>
            <div class="flex gap-3">
              <% dot_color = { "positive" => "bg-emerald-500", "neutral" => "bg-stone-300", "negative" => "bg-red-400" } %>
              <div class="w-3 h-3 rounded-full flex-shrink-0 mt-1.5 <%= dot_color[feedback.sentiment] || 'bg-stone-200' %>"></div>
              <div class="flex-1 min-w-0">
                <p class="text-[14px] text-stone-900 leading-relaxed line-clamp-2"><%= feedback.content %></p>
                <% if feedback.topics.present? %>
                  <div class="flex flex-wrap gap-1.5 mt-2">
                    <% feedback.topics.first(4).each do |topic| %>
                      <span class="text-[10px] bg-stone-100 text-stone-700 font-medium px-2 py-0.5 rounded-full"><%= topic %></span>
                    <% end %>
                  </div>
                <% end %>
                <div class="flex items-center gap-3 mt-2 text-[12px] text-stone-400">
                  <span><%= source_emoji(feedback.source&.source_type) %> <%= feedback.source&.source_type&.titleize %></span>
                  <span><%= feedback.author_name || "Anonymous" %></span>
                  <span><%= format_time_ago(feedback.received_at) %></span>
                  <% if feedback.processed? %>
                    <span class="text-emerald-600 font-medium">Processed</span>
                  <% else %>
                    <span class="text-amber-600 font-medium">Pending</span>
                  <% end %>
                  <% if feedback.priority_score.present? %>
                    <span class="<%= feedback.priority_color_class %> px-1.5 py-0.5 rounded-full font-semibold" title="<%= feedback.priority_reasoning %>"><%= feedback.priority_emoji %> P:<%= feedback.priority_score %></span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <div class="px-5 py-12 text-center">
          <p class="text-stone-400">No feedbacks found. Try adjusting your filters.</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Pagination -->
  <% total_pages = (@total_count.to_f / @per_page).ceil %>
  <% if total_pages > 1 %>
    <div class="mt-6 flex items-center justify-between">
      <p class="text-sm text-stone-500">Page <strong><%= @page %></strong> of <strong><%= total_pages %></strong></p>
      <div class="flex gap-3">
        <% if @page > 1 %>
          <%= link_to "← Previous", feedbacks_path(request.query_parameters.merge(page: @page - 1)), data: { turbo_frame: "feedbacks_list" }, class: "px-4 py-2 border border-stone-300 rounded-lg text-sm font-medium text-stone-700 bg-white hover:bg-stone-50" %>
        <% end %>
        <% if @page < total_pages %>
          <%= link_to "Next →", feedbacks_path(request.query_parameters.merge(page: @page + 1)), data: { turbo_frame: "feedbacks_list" }, class: "px-4 py-2 border border-stone-300 rounded-lg text-sm font-medium text-stone-700 bg-white hover:bg-stone-50" %>
        <% end %>
      </div>
    </div>
  <% end %>
  <% end %>
</div>
