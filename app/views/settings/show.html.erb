<% content_for(:page_title) { "Settings" } %>

<div class="max-w-4xl mx-auto space-y-6">
  <!-- Account Section (inside form) -->
  <%= form_with model: current_account, url: settings_path, method: :patch, data: { turbo: false }, class: "space-y-6" do |f| %>
    <div class="bg-white rounded-xl border border-stone-200 p-6">
      <h2 class="text-lg font-bold text-stone-900 mb-6">Account Settings</h2>
      <div class="space-y-6">
        <div>
          <%= f.label :name, "Account Name", class: "block text-sm font-semibold text-stone-900 mb-2" %>
          <%= f.text_field :name, class: "w-full px-4 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500 outline-none" %>
          <p class="text-xs text-stone-600 mt-1">This name is displayed throughout the app</p>
        </div>
        <div>
          <%= f.label :subdomain, "Workspace Subdomain", class: "block text-sm font-semibold text-stone-900 mb-2" %>
          <div class="flex items-center gap-2">
            <span class="text-stone-600">https://</span>
            <%= f.text_field :subdomain, class: "flex-1 px-4 py-2 border border-stone-300 rounded-lg focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500 outline-none" %>
            <span class="text-stone-600">.feedbackmind.io</span>
          </div>
          <p class="text-xs text-stone-600 mt-1">Your workspace URL</p>
        </div>
      </div>
      <div class="flex gap-3 pt-6">
        <%= f.submit "Save Changes", class: "px-6 py-3 rounded-lg bg-stone-900 text-white font-semibold hover:bg-stone-800 transition-colors cursor-pointer" %>
        <%= link_to "Cancel", settings_path, class: "px-6 py-3 rounded-lg border border-stone-300 text-stone-700 font-semibold hover:bg-stone-50 transition-colors" %>
      </div>
    </div>
  <% end %>

  <!-- Team Section (outside form) -->
  <div class="bg-white rounded-xl border border-stone-200 p-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-lg font-bold text-stone-900">Team</h2>
      <%= link_to "Edit Profile", edit_user_registration_path, class: "text-sm text-stone-900 hover:text-stone-700 underline font-medium" %>
    </div>
    <% if current_account.users.any? %>
      <div class="space-y-3">
        <% current_account.users.each do |user| %>
          <div class="flex items-center justify-between p-4 border border-stone-200 rounded-lg hover:bg-stone-50 transition-colors">
            <div>
              <p class="font-medium text-stone-900"><%= user.name.presence || user.email %></p>
              <p class="text-xs text-stone-600 mt-1"><%= user.email %> · Joined <%= format_time_ago(user.created_at) %></p>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-xs px-3 py-1 rounded-full bg-stone-100 text-stone-700 font-semibold capitalize"><%= user.role %></span>
              <% if current_user.owner? && user != current_user %>
                <%= button_to "Remove", remove_member_settings_path(user_id: user.id), method: :delete,
                    class: "text-xs text-red-600 hover:text-red-800 font-medium",
                    data: { turbo_confirm: "Remove #{user.email} from the team?", turbo: false } %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
    <% if current_user.owner? %>
      <div class="mt-4 pt-4 border-t border-stone-200">
        <%= form_with url: invite_member_settings_path, method: :post, data: { turbo: false }, class: "flex gap-2" do %>
          <input type="email" name="email" placeholder="colleague@company.com"
            class="flex-1 px-4 py-2 border border-stone-300 rounded-lg text-sm focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500 outline-none transition" required>
          <button type="submit" class="px-4 py-2 rounded-lg bg-stone-900 text-white text-sm font-medium hover:bg-stone-800 transition-colors">Invite Member</button>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- API Section (outside form) -->
  <div class="bg-white rounded-xl border border-stone-200 p-6">
    <h2 class="text-lg font-bold text-stone-900 mb-6">API</h2>
    <div data-controller="clipboard">
      <label class="block text-sm font-semibold text-stone-900 mb-2">API Token</label>
      <div class="flex items-center gap-2">
        <input type="text" value="<%= current_account.api_token %>"
               class="flex-1 px-4 py-2 border border-stone-300 rounded-lg bg-stone-50 font-mono text-sm"
               data-clipboard-target="source" readonly />
        <button type="button" data-action="click->clipboard#copy"
                class="px-4 py-2 rounded-lg border border-stone-300 text-stone-700 hover:bg-stone-50 transition-colors font-medium text-sm">Copy</button>
        <%= button_to "Regenerate", regenerate_token_settings_path, method: :post,
            class: "px-4 py-2 rounded-lg border border-red-300 text-red-700 hover:bg-red-50 transition-colors font-medium text-sm",
            data: { turbo_confirm: "Are you sure? This will invalidate your current API token.", turbo: false } %>
      </div>
      <p class="text-xs text-stone-600 mt-2">
        Use this token in the <code class="bg-stone-100 px-1 rounded">Authorization: Bearer fm_xxx</code> header.
      </p>
    </div>
  </div>

  <!-- Slack Notifications -->
  <div class="bg-white rounded-xl border border-stone-200 p-6">
    <h2 class="text-lg font-bold text-stone-900 mb-6">Slack Notifications</h2>
    <p class="text-sm text-stone-600 mb-4">Receive real-time alerts in Slack when new feedback arrives or critical issues are detected.</p>
    <%= form_with model: current_account, url: settings_path, method: :patch, data: { turbo: false } do |f| %>
      <div class="flex items-center gap-2">
        <%= f.text_field :slack_webhook_url, placeholder: "https://hooks.slack.com/services/...",
            class: "flex-1 px-4 py-2 border border-stone-300 rounded-lg text-sm font-mono focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500 outline-none" %>
        <%= f.submit "Save", class: "px-4 py-2 rounded-lg bg-stone-900 text-white text-sm font-medium hover:bg-stone-800 transition-colors cursor-pointer" %>
      </div>
      <p class="text-xs text-stone-500 mt-2">
        Create an <a href="https://api.slack.com/messaging/webhooks" target="_blank" class="text-stone-900 underline decoration-stone-300">Incoming Webhook</a> in your Slack workspace settings.
      </p>
    <% end %>
  </div>

  <!-- Billing Section (outside form — button_to creates its own forms) -->
  <div class="bg-white rounded-xl border border-stone-200 p-6">
    <h2 class="text-lg font-bold text-stone-900 mb-6">Billing</h2>
    <div class="grid grid-cols-2 gap-6 mb-6">
      <div>
        <p class="text-xs font-semibold text-stone-600 uppercase tracking-wide mb-2">Current Plan</p>
        <p class="text-2xl font-bold text-stone-900 font-serif-display"><%= current_account.plan.titleize %></p>
        <p class="text-sm text-stone-600 mt-2">
          <%= case current_account.plan
              when "starter" then "$29/month"
              when "growth" then "$109/month"
              when "scale" then "$209/month"
              end %>
        </p>
      </div>
      <div>
        <p class="text-xs font-semibold text-stone-600 uppercase tracking-wide mb-2">Usage This Month</p>
        <% limit = current_account.plan_limits[:feedbacks_per_month] %>
        <% usage_pct = limit == Float::INFINITY ? 0 : ((current_account.feedback_count_this_month.to_f / limit) * 100).round %>
        <p class="text-2xl font-bold text-stone-900"><%= usage_pct %>%</p>
        <p class="text-sm text-stone-600 mt-2">
          <%= number_with_delimiter(current_account.feedback_count_this_month) %> /
          <%= current_account.plan_scale? ? "Unlimited" : number_with_delimiter(limit) %> feedbacks
        </p>
        <div class="w-full bg-stone-200 rounded-full h-2 mt-3">
          <div class="bg-stone-900 h-2 rounded-full transition-all" style="width: <%= [usage_pct, 100].min %>%"></div>
        </div>
      </div>
    </div>
    <!-- Plan Selector -->
    <div class="grid grid-cols-3 gap-3 mb-6">
      <% [
        { key: "starter", price: "$29/mo", desc: "1 user · 3 sources · 1K feedbacks" },
        { key: "growth", price: "$109/mo", desc: "5 users · 10 sources · 10K feedbacks · AI Chat" },
        { key: "scale", price: "$209/mo", desc: "Unlimited everything · API access" }
      ].each do |plan| %>
        <% is_current = current_account.plan == plan[:key] %>
        <div class="rounded-xl border-2 p-4 <%= is_current ? 'border-stone-900 bg-stone-50' : 'border-stone-200 hover:border-stone-400' %> transition-all">
          <div class="flex items-center justify-between mb-2">
            <p class="text-sm font-bold text-stone-900"><%= plan[:key].titleize %></p>
            <% if is_current %>
              <span class="text-[10px] font-bold bg-stone-900 text-white px-2 py-0.5 rounded-full">Current</span>
            <% end %>
          </div>
          <p class="text-lg font-bold text-stone-900 font-serif-display mb-1"><%= plan[:price] %></p>
          <p class="text-xs text-stone-500 mb-3"><%= plan[:desc] %></p>
          <% unless is_current %>
            <%= button_to plan[:key] == "starter" ? "Downgrade" : "Upgrade",
                change_plan_settings_path(plan: plan[:key]),
                method: :post,
                form: { data: { turbo: "false" } },
                class: "w-full text-center py-2 rounded-lg text-xs font-semibold #{plan[:key] == 'starter' ? 'border border-stone-300 text-stone-700 hover:bg-stone-50' : 'bg-stone-900 text-white hover:bg-stone-800'} transition-colors" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- AI Priority Scoring -->
  <div class="bg-white rounded-xl border border-stone-200 p-6">
    <div class="flex items-center gap-2 mb-6">
      <h2 class="text-lg font-bold text-stone-900">AI Priority Scoring</h2>
      <span class="bg-indigo-500 text-white text-[9px] font-bold px-1.5 py-0.5 rounded">AI</span>
    </div>
    <% scored = current_account.feedbacks.with_priority.count %>
    <% pending = current_account.feedbacks.processed.where(priority_score: nil).count %>
    <div class="grid grid-cols-2 gap-6 mb-6">
      <div>
        <p class="text-xs font-semibold text-stone-600 uppercase tracking-wide mb-2">Scored</p>
        <p class="text-2xl font-bold text-emerald-600"><%= scored %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-stone-600 uppercase tracking-wide mb-2">Pending</p>
        <p class="text-2xl font-bold text-stone-900"><%= pending %></p>
      </div>
    </div>
    <p class="text-sm text-stone-600 mb-4">Score all processed feedbacks using AI to calculate urgency, business impact, frequency, and sentiment severity (1-100).</p>
    <%= button_to "Score All", bulk_priority_settings_path, method: :post,
        data: { turbo: false },
        class: "px-4 py-2 rounded-lg bg-stone-900 text-white text-sm font-medium hover:bg-stone-800 transition-colors" %>
  </div>

  <!-- Danger Zone (outside form) -->
  <div class="bg-white rounded-xl border-2 border-red-200 p-6">
    <h2 class="text-lg font-bold text-red-900 mb-6">Danger Zone</h2>
    <div class="space-y-4">
      <div class="flex items-center justify-between p-4 bg-red-50 rounded-lg border border-red-100">
        <div>
          <p class="font-semibold text-red-900">Delete Account</p>
          <p class="text-sm text-red-800 mt-1">Permanently delete this workspace and all associated data</p>
        </div>
        <button type="button" class="px-4 py-2 rounded-lg border-2 border-red-500 text-red-600 hover:bg-red-50 transition-colors font-semibold text-sm opacity-50 cursor-not-allowed" disabled title="Contact support to delete your account">
          Delete
        </button>
      </div>
    </div>
  </div>
</div>
