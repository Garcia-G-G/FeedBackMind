<% content_for(:page_title) { "Settings" } %>

<div class="max-w-4xl mx-auto space-y-6">
  <%= form_with model: current_account, url: settings_path, method: :patch, local: true, class: "space-y-6" do |f| %>
    <!-- Account Section -->
    <div class="bg-white rounded-xl border border-gray-100 p-6">
      <h2 class="text-lg font-bold text-gray-900 mb-6">Account Settings</h2>

      <div class="space-y-6">
        <div>
          <%= f.label :name, "Account Name", class: "block text-sm font-semibold text-gray-900 mb-2" %>
          <%= f.text_field :name, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none" %>
          <p class="text-xs text-gray-600 mt-1">This name is displayed throughout the app</p>
        </div>

        <div>
          <%= f.label :subdomain, "Workspace Subdomain", class: "block text-sm font-semibold text-gray-900 mb-2" %>
          <div class="flex items-center gap-2">
            <span class="text-gray-600">https://</span>
            <%= f.text_field :subdomain, class: "flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none" %>
            <span class="text-gray-600">.feedbackmind.io</span>
          </div>
          <p class="text-xs text-gray-600 mt-1">Your workspace URL</p>
        </div>
      </div>
    </div>

    <!-- Team Section -->
    <div class="bg-white rounded-xl border border-gray-100 p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-lg font-bold text-gray-900">Team</h2>
        <button type="button" class="px-4 py-2 rounded-lg bg-indigo-500 text-white hover:bg-indigo-600 transition-colors font-medium text-sm">
          + Invite Member
        </button>
      </div>

      <% if current_account.users.any? %>
        <div class="space-y-3">
          <% current_account.users.each do |user| %>
            <div class="flex items-center justify-between p-4 border border-gray-100 rounded-lg hover:bg-gray-50 transition-colors">
              <div>
                <p class="font-medium text-gray-900">
                  <%= user.email %>
                </p>
                <p class="text-xs text-gray-600 mt-1">
                  Joined <%= format_time_ago(user.created_at) %>
                </p>
              </div>
              <div class="text-right">
                <span class="text-xs px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 font-semibold">
                  Admin
                </span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="p-8 text-center text-gray-500">
          <p class="text-sm">No team members yet</p>
        </div>
      <% end %>
    </div>

    <!-- API Section -->
    <div class="bg-white rounded-xl border border-gray-100 p-6">
      <h2 class="text-lg font-bold text-gray-900 mb-6">API</h2>

      <div>
        <label class="block text-sm font-semibold text-gray-900 mb-2">API Token</label>
        <div class="flex items-center gap-2">
          <input type="password" value="••••••••••••••••••••••••••••••••" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg bg-gray-50" disabled />
          <button type="button" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition-colors font-medium text-sm">
            Copy
          </button>
          <button type="button" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition-colors font-medium text-sm">
            Regenerate
          </button>
        </div>
        <p class="text-xs text-gray-600 mt-2">
          Use this token to authenticate API requests. Keep it secret and secure.
        </p>
      </div>
    </div>

    <!-- Billing Section -->
    <div class="bg-white rounded-xl border border-gray-100 p-6">
      <h2 class="text-lg font-bold text-gray-900 mb-6">Billing</h2>

      <div class="grid grid-cols-2 gap-6 mb-6">
        <div>
          <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide mb-2">Current Plan</p>
          <p class="text-2xl font-bold text-indigo-600">Professional</p>
          <p class="text-sm text-gray-600 mt-2">$99/month</p>
        </div>
        <div>
          <p class="text-xs font-semibold text-gray-600 uppercase tracking-wide mb-2">Usage This Month</p>
          <p class="text-2xl font-bold text-gray-900">68%</p>
          <p class="text-sm text-gray-600 mt-2">6,800 / 10,000 feedbacks</p>
        </div>
      </div>

      <div class="bg-blue-50 border border-blue-100 rounded-lg p-4 mb-6">
        <div class="flex items-start gap-3">
          <svg class="h-5 w-5 text-blue-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 5v8a2 2 0 01-2 2h-5l-5 4v-4H4a2 2 0 01-2-2V5a2 2 0 012-2h12a2 2 0 012 2zm-11-1a1 1 0 11-2 0 1 1 0 012 0zM8 7a1 1 0 000 2h6a1 1 0 000-2H8zm0 3a1 1 0 000 2h6a1 1 0 000-2H8z" clip-rule="evenodd" />
          </svg>
          <div>
            <p class="text-sm font-semibold text-blue-900">Upgrade available</p>
            <p class="text-sm text-blue-800 mt-1">Unlock unlimited feedbacks and advanced analytics</p>
          </div>
        </div>
      </div>

      <button type="button" class="px-6 py-2.5 rounded-lg bg-indigo-500 text-white hover:bg-indigo-600 transition-colors font-semibold text-sm">
        View Plans & Upgrade
      </button>
    </div>

    <!-- Danger Zone -->
    <div class="bg-white rounded-xl border-2 border-red-200 p-6">
      <h2 class="text-lg font-bold text-red-900 mb-6">Danger Zone</h2>

      <div class="space-y-4">
        <div class="flex items-center justify-between p-4 bg-red-50 rounded-lg border border-red-100">
          <div>
            <p class="font-semibold text-red-900">Delete Account</p>
            <p class="text-sm text-red-800 mt-1">Permanently delete this workspace and all associated data</p>
          </div>
          <button type="button" class="px-4 py-2 rounded-lg border-2 border-red-500 text-red-600 hover:bg-red-50 transition-colors font-semibold text-sm">
            Delete
          </button>
        </div>
      </div>
    </div>

    <!-- Form actions -->
    <div class="flex gap-3 pt-4">
      <%= f.submit "Save Changes", class: "px-6 py-3 rounded-lg bg-indigo-500 text-white font-semibold hover:bg-indigo-600 transition-colors cursor-pointer" %>
      <%= link_to "Cancel", settings_path, class: "px-6 py-3 rounded-lg border border-gray-300 text-gray-700 font-semibold hover:bg-gray-50 transition-colors" %>
    </div>
  <% end %>
</div>
