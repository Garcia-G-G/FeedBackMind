<% content_for(:page_title) { "Week of #{@synthesis.week_label}" } %>

<div class="space-y-6">
  <!-- Back link -->
  <div class="flex items-center gap-2 text-sm">
    <%= link_to syntheses_path, class: "text-stone-900 hover:text-stone-700 font-medium" do %>
      ← Syntheses
    <% end %>
  </div>

  <!-- Header -->
  <div class="bg-white rounded-xl border border-stone-200 p-6">
    <div class="flex items-start justify-between mb-4">
      <div>
        <h1 class="text-2xl font-bold text-stone-900 font-serif-display mb-2">
          <%= @synthesis.week_label %>
        </h1>
        <p class="text-stone-600">
          <span class="font-medium text-stone-700"><%= @synthesis.feedback_count %></span>
          feedbacks analyzed
        </p>
      </div>
      <div class="flex items-center gap-3">
        <% if @synthesis.sent_at.present? %>
          <div class="text-right">
            <span class="text-xs px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 font-semibold">
              ✓ Sent <%= format_time_ago(@synthesis.sent_at) %>
            </span>
          </div>
        <% else %>
          <%= link_to synthesis_path(@synthesis), method: :patch, params: { mark_as_sent: true }, class: "inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-stone-900 text-white hover:bg-stone-800 transition-colors font-medium text-sm" do %>
            📧 Email Digest
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Themes -->
  <div class="space-y-3">
    <h2 class="text-lg font-bold text-stone-900 px-1">Key Themes</h2>

    <% if @synthesis.themes.any? %>
      <% @synthesis.themes.each do |theme| %>
        <div class="bg-white rounded-xl border border-stone-200 p-6 hover:shadow-sm transition-shadow">
          <!-- Header with urgency -->
          <div class="flex items-start justify-between mb-3">
            <h3 class="text-base font-semibold text-stone-900 flex-1">
              <%= theme.title %>
            </h3>
            <% urgency_classes = urgency_color(theme.urgency) %>
            <span class="<%= urgency_classes %> whitespace-nowrap ml-3 text-xs font-semibold px-3 py-1 rounded-full">
              <%= theme.urgency.titleize %>
            </span>
          </div>

          <!-- Description -->
          <p class="text-sm text-stone-600 mb-4 leading-relaxed">
            <%= theme.description %>
          </p>

          <!-- Stats -->
          <div class="flex items-center gap-6 mb-4 text-sm">
            <div class="flex items-center gap-2 text-stone-700">
              <svg class="h-4 w-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V5a2 2 0 012-2h14a2 2 0 012 2v12a2 2 0 01-2 2h-3l-4 4z" />
              </svg>
              <span><strong><%= theme.feedback_count %></strong> feedbacks</span>
            </div>
            <% if theme.respond_to?(:sources) && theme.sources.present? %>
              <div class="flex items-center gap-2 text-stone-700">
                <svg class="h-4 w-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.658 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                </svg>
                <span><%= theme.sources.join(", ") %></span>
              </div>
            <% end %>
          </div>

          <!-- Action items -->
          <% if theme.respond_to?(:action_items) && theme.action_items.present? %>
            <div class="border-t border-stone-200 pt-4">
              <p class="text-xs font-semibold text-stone-700 uppercase tracking-wide mb-3">
                Suggested Actions
              </p>
              <ul class="space-y-2">
                <% theme.action_items.each do |action| %>
                  <li class="flex items-start gap-3 text-sm">
                    <span class="text-stone-900 font-bold mt-0.5">•</span>
                    <span class="text-stone-700"><%= action %></span>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="bg-white rounded-xl border border-stone-200 p-8 text-center">
        <p class="text-stone-600">No themes generated for this week yet.</p>
      </div>
    <% end %>
  </div>
</div>
