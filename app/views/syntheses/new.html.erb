<% content_for(:page_title) { "Generate Synthesis" } %>

<div class="max-w-2xl mx-auto">
  <div class="bg-white rounded-xl border border-stone-200 p-8">
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-stone-900 font-serif-display mb-2">Generate Weekly Synthesis</h1>
      <p class="text-stone-600">
        This will analyze all feedbacks from the past 7 days and generate AI-powered themes.
      </p>
    </div>

    <%= form_with local: true, url: syntheses_path, method: :post, class: "space-y-6" do |f| %>
      <div class="bg-indigo-50 border border-indigo-100 rounded-lg p-4">
        <div class="flex gap-3">
          <div class="text-indigo-600 mt-0.5">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 5v8a2 2 0 01-2 2h-5l-5 4v-4H4a2 2 0 01-2-2V5a2 2 0 012-2h12a2 2 0 012 2zm-11-1a1 1 0 11-2 0 1 1 0 012 0zM8 7a1 1 0 000 2h6a1 1 0 000-2H8zm0 3a1 1 0 000 2h6a1 1 0 000-2H8z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-indigo-900">Smart Analysis</p>
            <p class="text-sm text-indigo-800 mt-1">
              Our AI groups similar feedback into actionable themes and identifies patterns across all your sources.
            </p>
          </div>
        </div>
      </div>

      <div class="border-t border-stone-200 pt-6">
        <h3 class="text-sm font-semibold text-stone-900 mb-4">Analysis Period</h3>
        <div class="flex items-center gap-3 p-3 bg-stone-50 rounded-lg">
          <svg class="h-5 w-5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <div>
            <p class="text-sm font-medium text-stone-900">Last 7 days</p>
            <p class="text-xs text-stone-600">
              <%= (Date.today - 7.days).strftime("%b %d") %> - <%= Date.today.strftime("%b %d, %Y") %>
            </p>
          </div>
        </div>
      </div>

      <div class="flex gap-3 pt-4">
        <%= f.submit "⚡ Generate Now", class: "flex-1 px-6 py-3 rounded-lg bg-stone-900 text-white font-semibold hover:bg-stone-800 transition-colors cursor-pointer" %>
        <%= link_to "Cancel", syntheses_path, class: "px-6 py-3 rounded-lg border border-stone-300 text-stone-700 font-semibold hover:bg-stone-50 transition-colors" %>
      </div>
    <% end %>
  </div>

  <div class="mt-8 bg-blue-50 border border-blue-100 rounded-xl p-6">
    <div class="flex gap-3">
      <div class="text-blue-600 mt-0.5 flex-shrink-0">
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 5v8a2 2 0 01-2 2h-5l-5 4v-4H4a2 2 0 01-2-2V5a2 2 0 012-2h12a2 2 0 012 2zm-11-1a1 1 0 11-2 0 1 1 0 012 0zM8 7a1 1 0 000 2h6a1 1 0 000-2H8zm0 3a1 1 0 000 2h6a1 1 0 000-2H8z" clip-rule="evenodd" />
        </svg>
      </div>
      <div>
        <p class="text-sm font-semibold text-blue-900 mb-1">Tip</p>
        <p class="text-sm text-blue-800">
          The more feedback data you have, the better the synthesis. Make sure your sources are connected and up-to-date.
        </p>
      </div>
    </div>
  </div>
</div>
