<% content_for(:page_title) { "Edit: #{@company.name}" } %>

<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <%= link_to company_path(@company), class: "text-sm text-stone-900 hover:text-stone-700 font-medium" do %>
      &larr; <%= @company.name %>
    <% end %>
  </div>

  <div class="bg-white rounded-xl border border-stone-200 p-6">
    <h2 class="text-xl font-bold text-stone-900 font-serif-display mb-6">Edit Company</h2>

    <%= form_with model: @company, data: { turbo: false } do |f| %>
      <% if @company.errors.any? %>
        <div class="mb-4 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800">
          <ul class="list-disc list-inside">
            <% @company.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-5">
        <div>
          <label class="block text-sm font-semibold text-stone-700 mb-1">Company Name <span class="text-red-500">*</span></label>
          <%= f.text_field :name,
              class: "w-full px-4 py-2.5 rounded-lg border border-stone-300 text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent",
              required: true %>
        </div>

        <div>
          <label class="block text-sm font-semibold text-stone-700 mb-1">Domain</label>
          <%= f.text_field :domain, placeholder: "acmecorp.com",
              class: "w-full px-4 py-2.5 rounded-lg border border-stone-300 text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent" %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-stone-700 mb-1">Segment</label>
            <%= f.select :segment,
                options_for_select(Company::SEGMENTS.map { |s| [s, s] }, @company.segment),
                { include_blank: "Select segment..." },
                class: "w-full px-4 py-2.5 rounded-lg border border-stone-300 text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent" %>
          </div>
          <div>
            <label class="block text-sm font-semibold text-stone-700 mb-1">MRR ($)</label>
            <%= f.number_field :mrr, step: 0.01, min: 0, placeholder: "0.00",
                class: "w-full px-4 py-2.5 rounded-lg border border-stone-300 text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent" %>
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-stone-700 mb-1">Notes</label>
          <%= f.text_area :notes, rows: 4, placeholder: "Internal notes about this company...",
              class: "w-full px-4 py-2.5 rounded-lg border border-stone-300 text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent resize-y" %>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <%= link_to "Cancel", company_path(@company),
              class: "px-4 py-2.5 rounded-lg border border-stone-300 text-sm font-medium text-stone-700 hover:bg-stone-50 transition-colors" %>
          <%= f.submit "Update Company",
              class: "px-5 py-2.5 rounded-lg bg-stone-900 text-white text-sm font-semibold hover:bg-stone-800 transition-colors cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
