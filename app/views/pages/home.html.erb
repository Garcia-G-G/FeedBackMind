<%# Marketing landing page — Editorial design %>
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <title>FeedbackMind — AI-Powered Feedback Intelligence for Product Teams</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Connect all your feedback sources. FeedbackMind reads every message, finds the patterns, and tells you what to build next.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= csrf_meta_tags %>
  <style>
    .font-serif-display { font-family: 'DM Serif Display', Georgia, serif; }
    .font-sans-dm { font-family: 'DM Sans', -apple-system, sans-serif; }
    .perspective-card { transform: perspective(1200px) rotateY(-2deg) rotateX(1deg); transition: transform 0.4s ease; }
    .perspective-card:hover { transform: perspective(1200px) rotateY(0deg) rotateX(0deg); }
  </style>
</head>
<body class="font-sans-dm bg-white text-stone-900 antialiased overflow-x-hidden">

  <!-- ━━━ NAV ━━━ -->
  <nav class="fixed top-0 inset-x-0 z-50 bg-white/85 backdrop-blur-xl border-b border-black/[0.04]">
    <div class="max-w-[1200px] mx-auto px-8 h-14 flex items-center justify-between">
      <a href="/" class="font-bold text-[17px] tracking-tight text-stone-900">FeedbackMind</a>
      <div class="flex items-center gap-7">
        <a href="#features" class="text-[13.5px] font-medium text-stone-500 hover:text-stone-900 transition-colors">Features</a>
        <a href="#pricing" class="text-[13.5px] font-medium text-stone-500 hover:text-stone-900 transition-colors">Pricing</a>
        <%= link_to "Log in", new_user_session_path, class: "text-[13.5px] font-medium text-stone-500 hover:text-stone-900 transition-colors" %>
        <%= link_to "Start free trial", new_user_registration_path, class: "text-[13px] font-semibold bg-stone-900 text-white px-4 py-[7px] rounded-md hover:bg-stone-800 transition-colors" %>
      </div>
    </div>
  </nav>

  <!-- ━━━ HERO ━━━ -->
  <section class="pt-36 pb-20 px-8">
    <div class="max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
      <!-- Left: copy -->
      <div class="max-w-[520px]">
        <p class="text-xs font-semibold uppercase tracking-[0.1em] text-indigo-600 mb-5">For product teams</p>
        <h1 class="font-serif-display text-[50px] leading-[1.08] tracking-tight mb-6">
          Your users are already telling you what to build <em class="italic text-stone-500">next</em>
        </h1>
        <p class="text-[17px] leading-[1.65] text-stone-500 mb-9 max-w-[440px]">
          FeedbackMind connects to every channel where customers talk, finds patterns across thousands of messages, and tells you what matters this week.
        </p>
        <%= link_to new_user_registration_path, class: "inline-flex items-center gap-2.5 bg-stone-900 text-white px-7 py-3.5 rounded-lg text-sm font-semibold hover:bg-stone-800 transition-all hover:-translate-y-0.5" do %>
          Start free trial
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <% end %>
        <p class="text-xs text-stone-400 mt-3.5">Free for 14 days · No credit card required</p>
      </div>

      <!-- Right: product mockup with 3D perspective -->
      <div class="relative">
        <div class="perspective-card bg-stone-900 rounded-2xl overflow-hidden shadow-[0_32px_80px_rgba(0,0,0,0.12),0_0_0_1px_rgba(0,0,0,0.04)]">
          <!-- Window chrome -->
          <div class="flex items-center gap-[7px] px-4 py-3 border-b border-white/[0.06]">
            <span class="w-[10px] h-[10px] rounded-full bg-red-500"></span>
            <span class="w-[10px] h-[10px] rounded-full bg-yellow-400"></span>
            <span class="w-[10px] h-[10px] rounded-full bg-green-500"></span>
          </div>
          <!-- Dashboard content -->
          <div class="p-6">
            <div class="flex justify-between items-baseline mb-6">
              <span class="text-white text-[15px] font-semibold">Weekly Synthesis</span>
              <span class="text-stone-500 text-xs">Mar 10 – 16, 2026</span>
            </div>
            <!-- Metrics row -->
            <div class="grid grid-cols-3 gap-3 mb-7">
              <div class="bg-white/[0.04] border border-white/[0.06] rounded-xl p-4">
                <div class="text-white text-2xl font-bold tracking-tight">1,247</div>
                <div class="text-stone-500 text-[11px] mt-1">Feedbacks</div>
              </div>
              <div class="bg-white/[0.04] border border-white/[0.06] rounded-xl p-4">
                <div class="text-white text-2xl font-bold tracking-tight">72%</div>
                <div class="text-stone-500 text-[11px] mt-1">Positive</div>
              </div>
              <div class="bg-white/[0.04] border border-white/[0.06] rounded-xl p-4">
                <div class="text-white text-2xl font-bold tracking-tight">8</div>
                <div class="text-stone-500 text-[11px] mt-1">Themes</div>
              </div>
            </div>
            <!-- Theme rows -->
            <div class="space-y-2">
              <div class="flex items-center gap-3 bg-white/[0.03] border border-white/[0.05] rounded-lg p-3">
                <div class="w-[3px] h-7 rounded bg-red-500 shrink-0"></div>
                <div class="flex-1 min-w-0">
                  <div class="text-stone-200 text-[13px] font-medium">Mobile app crashes on iOS 19</div>
                  <div class="text-stone-500 text-[11px]">142 mentions · 89% negative</div>
                </div>
                <span class="text-[10px] font-semibold px-2 py-[3px] rounded-full bg-red-500/10 text-red-400">Urgent</span>
              </div>
              <div class="flex items-center gap-3 bg-white/[0.03] border border-white/[0.05] rounded-lg p-3">
                <div class="w-[3px] h-7 rounded bg-green-500 shrink-0"></div>
                <div class="flex-1 min-w-0">
                  <div class="text-stone-200 text-[13px] font-medium">New export feature well received</div>
                  <div class="text-stone-500 text-[11px]">203 mentions · 94% positive</div>
                </div>
                <span class="text-[10px] font-semibold px-2 py-[3px] rounded-full bg-green-500/10 text-green-400">Positive</span>
              </div>
              <div class="flex items-center gap-3 bg-white/[0.03] border border-white/[0.05] rounded-lg p-3">
                <div class="w-[3px] h-7 rounded bg-amber-500 shrink-0"></div>
                <div class="flex-1 min-w-0">
                  <div class="text-stone-200 text-[13px] font-medium">Dashboard loading time complaints</div>
                  <div class="text-stone-500 text-[11px]">89 mentions · trending up</div>
                </div>
                <span class="text-[10px] font-semibold px-2 py-[3px] rounded-full bg-amber-500/10 text-amber-400">Rising</span>
              </div>
            </div>
          </div>
        </div>
        <!-- Floating annotations that break out of the card boundary -->
        <div class="absolute -left-10 bottom-16 bg-white rounded-xl p-4 shadow-[0_8px_32px_rgba(0,0,0,0.1),0_0_0_1px_rgba(0,0,0,0.04)] z-10 hidden lg:block">
          <div class="text-[10px] font-semibold uppercase tracking-[0.08em] text-stone-400 mb-1">Sentiment shift</div>
          <div class="text-green-600 text-lg font-bold">+12%</div>
          <div class="text-stone-400 text-[11.5px]">vs. last week</div>
        </div>
        <div class="absolute -right-7 top-20 bg-white rounded-xl p-4 shadow-[0_8px_32px_rgba(0,0,0,0.1),0_0_0_1px_rgba(0,0,0,0.04)] z-10 hidden lg:block">
          <div class="text-[10px] font-semibold uppercase tracking-[0.08em] text-stone-400 mb-1">Urgent issues</div>
          <div class="text-red-600 text-lg font-bold">3</div>
          <div class="text-stone-400 text-[11.5px]">need attention</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ━━━ SOCIAL PROOF ━━━ -->
  <section class="px-8 pb-16">
    <div class="max-w-[1200px] mx-auto flex items-center gap-12">
      <span class="text-xs font-semibold uppercase tracking-[0.08em] text-stone-400 whitespace-nowrap">Trusted by</span>
      <div class="flex gap-10 items-center flex-wrap">
        <span class="text-base font-bold text-stone-300">Lumina</span>
        <span class="text-base font-bold text-stone-300">Stackbase</span>
        <span class="text-base font-bold text-stone-300">Orbitly</span>
        <span class="text-base font-bold text-stone-300">Planum</span>
        <span class="text-base font-bold text-stone-300">Keyflow</span>
      </div>
    </div>
  </section>

  <!-- ━━━ EDITORIAL BLOCK ━━━ -->
  <section class="px-8 py-20">
    <div class="max-w-[620px] mx-auto">
      <h2 class="font-serif-display text-[34px] leading-[1.25] tracking-tight mb-7">The feedback problem isn't volume. It's visibility.</h2>
      <p class="text-[16.5px] leading-[1.75] text-stone-600 mb-5">
        Your team collects feedback from Intercom, Slack, surveys, support tickets, and app store reviews. Hundreds of messages every week. The data is there — the problem is that <strong class="text-stone-900 font-semibold">no one has time to read it all, remember it all, and connect the dots</strong>.
      </p>
      <blockquote class="font-serif-display italic text-[22px] leading-[1.5] text-stone-700 border-l-[3px] border-indigo-600 pl-6 my-10">
        "We had 2,000 support tickets last month. Somewhere in there was the signal to prioritize mobile performance. We found it three sprints too late."
      </blockquote>
      <p class="text-[16.5px] leading-[1.75] text-stone-600">
        FeedbackMind exists so that never happens again. It reads everything, finds the patterns, and delivers a clear weekly synthesis — so your roadmap reflects what users actually need, not what you <em>think</em> they need.
      </p>
    </div>
  </section>

  <!-- ━━━ FEATURE 1: SENTIMENT ━━━ -->
  <section id="features" class="py-24 px-8 bg-stone-50">
    <div class="max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-indigo-600 mb-3.5">Sentiment</p>
        <h3 class="font-serif-display text-[30px] leading-[1.2] tracking-tight mb-4">Context-aware sentiment, not just positive/negative</h3>
        <p class="text-[15.5px] leading-[1.7] text-stone-500 mb-6 max-w-[420px]">
          FeedbackMind understands sarcasm, mixed signals, and the difference between frustration and a feature request. Every piece of feedback gets scored on a nuanced scale.
        </p>
        <ul class="space-y-2">
          <li class="flex items-start gap-2.5 text-sm text-stone-700"><span class="text-stone-300 font-bold shrink-0">—</span> Detects frustration, confusion, delight, and urgency</li>
          <li class="flex items-start gap-2.5 text-sm text-stone-700"><span class="text-stone-300 font-bold shrink-0">—</span> Tracks sentiment trends week over week</li>
          <li class="flex items-start gap-2.5 text-sm text-stone-700"><span class="text-stone-300 font-bold shrink-0">—</span> Alerts you when sentiment drops on key themes</li>
        </ul>
      </div>
      <!-- Visual: stacked bar chart -->
      <div class="bg-white border border-stone-200 rounded-2xl p-8 shadow-[0_4px_24px_rgba(0,0,0,0.04)]">
        <div class="flex justify-between items-baseline mb-7">
          <span class="text-sm font-semibold">Sentiment over time</span>
          <span class="text-xs text-stone-400">Last 8 weeks</span>
        </div>
        <div class="flex items-end gap-1 h-[100px] mb-6">
          <% [[55,20,25],[60,18,22],[52,23,25],[45,20,35],[50,22,28],[58,24,18],[65,20,15],[72,16,12]].each do |pos, neu, neg| %>
            <div class="flex-1 flex flex-col gap-[2px]">
              <div class="rounded-t" style="height:<%= neg %>px;background:#ef4444"></div>
              <div style="height:<%= neu %>px;background:#fbbf24"></div>
              <div class="rounded-b" style="height:<%= pos %>px;background:#22c55e"></div>
            </div>
          <% end %>
        </div>
        <div class="flex gap-5">
          <div class="flex items-center gap-1.5 text-xs text-stone-500"><span class="w-2 h-2 rounded-sm bg-green-500"></span> Positive</div>
          <div class="flex items-center gap-1.5 text-xs text-stone-500"><span class="w-2 h-2 rounded-sm bg-yellow-400"></span> Neutral</div>
          <div class="flex items-center gap-1.5 text-xs text-stone-500"><span class="w-2 h-2 rounded-sm bg-red-500"></span> Negative</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ━━━ FEATURE 2: THEMES (reversed layout) ━━━ -->
  <section class="py-24 px-8">
    <div class="max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
      <!-- Visual first on desktop -->
      <div class="bg-white border border-stone-200 rounded-2xl p-7 shadow-[0_4px_24px_rgba(0,0,0,0.04)] order-2 lg:order-1">
        <% [
          ["1", "Mobile app performance", "142 mentions · mostly iOS", "↑ 34%", "green"],
          ["2", "Dashboard load time", "89 mentions · enterprise segment", "↑ 18%", "green"],
          ["3", "Onboarding confusion", "67 mentions · new users", "New", "indigo"],
          ["4", "Pricing page unclear", "56 mentions · trial users", "↓ 8%", "red"]
        ].each_with_index do |(rank, name, mentions, trend, color), i| %>
          <div class="flex items-center py-3.5 <%= i < 3 ? 'border-b border-stone-100' : '' %>">
            <span class="font-serif-display text-[22px] text-stone-300 w-9 shrink-0"><%= rank %></span>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-semibold text-stone-900"><%= name %></div>
              <div class="text-xs text-stone-400"><%= mentions %></div>
            </div>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full
              <%= color == 'green' ? 'bg-green-50 text-green-600' : '' %>
              <%= color == 'red' ? 'bg-red-50 text-red-600' : '' %>
              <%= color == 'indigo' ? 'bg-indigo-50 text-indigo-600' : '' %>
            "><%= trend %></span>
          </div>
        <% end %>
      </div>
      <!-- Text second on desktop -->
      <div class="order-1 lg:order-2">
        <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-indigo-600 mb-3.5">Themes</p>
        <h3 class="font-serif-display text-[30px] leading-[1.2] tracking-tight mb-4">Patterns surface automatically — no tagging required</h3>
        <p class="text-[15.5px] leading-[1.7] text-stone-500 mb-6 max-w-[420px]">
          Using vector embeddings (not keyword matching), FeedbackMind clusters similar feedback into themes with urgency scores, trend direction, and representative quotes.
        </p>
        <ul class="space-y-2">
          <li class="flex items-start gap-2.5 text-sm text-stone-700"><span class="text-stone-300 font-bold shrink-0">—</span> Clusters by meaning, not just keywords</li>
          <li class="flex items-start gap-2.5 text-sm text-stone-700"><span class="text-stone-300 font-bold shrink-0">—</span> Tracks new and rising themes week over week</li>
          <li class="flex items-start gap-2.5 text-sm text-stone-700"><span class="text-stone-300 font-bold shrink-0">—</span> Urgency scoring based on volume, sentiment, and velocity</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ━━━ FEATURE 3: AI CHAT ━━━ -->
  <section class="py-24 px-8 bg-stone-50">
    <div class="max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-indigo-600 mb-3.5">AI Chat</p>
        <h3 class="font-serif-display text-[30px] leading-[1.2] tracking-tight mb-4">Ask your feedback database anything</h3>
        <p class="text-[15.5px] leading-[1.7] text-stone-500 mb-6 max-w-[420px]">
          Don't wait for the weekly report. Ask questions like "what do enterprise users think about our API?" and get instant, source-cited answers from your entire feedback history.
        </p>
        <ul class="space-y-2">
          <li class="flex items-start gap-2.5 text-sm text-stone-700"><span class="text-stone-300 font-bold shrink-0">—</span> Natural language queries across all your data</li>
          <li class="flex items-start gap-2.5 text-sm text-stone-700"><span class="text-stone-300 font-bold shrink-0">—</span> Every answer cites specific feedback sources</li>
          <li class="flex items-start gap-2.5 text-sm text-stone-700"><span class="text-stone-300 font-bold shrink-0">—</span> Follow-up questions to drill deeper</li>
        </ul>
      </div>
      <!-- Chat mockup -->
      <div class="bg-white border border-stone-200 rounded-2xl overflow-hidden shadow-[0_4px_24px_rgba(0,0,0,0.04)]">
        <div class="px-6 py-4 border-b border-stone-100 text-[13px] font-semibold flex items-center gap-2">
          <span class="w-[7px] h-[7px] bg-green-500 rounded-full"></span>
          Ask your feedback
        </div>
        <div class="p-5 space-y-4">
          <div class="ml-auto max-w-[80%] bg-stone-900 text-white px-4 py-3 rounded-xl rounded-br text-[13.5px] leading-relaxed">
            What are enterprise users saying about onboarding?
          </div>
          <div class="mr-auto max-w-[80%] bg-stone-50 border border-stone-100 text-stone-800 px-4 py-3 rounded-xl rounded-bl text-[13.5px] leading-relaxed">
            Based on <strong class="text-stone-900">312 feedbacks</strong> from enterprise accounts this quarter: <strong class="text-stone-900">SSO integration</strong> (47 mentions), <strong class="text-stone-900">role-based permissions</strong> (38), and <strong class="text-stone-900">bulk user import</strong> (29) are the top requests. Sentiment around onboarding has dropped 18% since February — primarily driven by teams with 50+ seats.
          </div>
          <div class="ml-auto max-w-[80%] bg-stone-900 text-white px-4 py-3 rounded-xl rounded-br text-[13.5px] leading-relaxed">
            Which customers mentioned SSO specifically?
          </div>
          <div class="mr-auto max-w-[80%] bg-stone-50 border border-stone-100 text-stone-800 px-4 py-3 rounded-xl rounded-bl text-[13.5px] leading-relaxed">
            SSO was mentioned by <strong class="text-stone-900">12 enterprise accounts</strong>, including Acme Corp (via Intercom, 3 tickets), Globex (Slack, 2 messages), and Initech (NPS survey). 8 of 12 rated it as "blocking procurement."
          </div>
        </div>
        <div class="px-6 py-3.5 border-t border-stone-100 flex items-center gap-3">
          <span class="text-[13px] text-stone-400 flex-1">Ask a follow-up question…</span>
          <span class="w-7 h-7 bg-stone-900 rounded-md flex items-center justify-center">
            <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ━━━ INTEGRATIONS (shared border grid) ━━━ -->
  <section class="py-20 px-8">
    <div class="max-w-[1200px] mx-auto">
      <div class="flex justify-between items-baseline mb-10">
        <h2 class="font-serif-display text-[28px] tracking-tight">Connects to your stack</h2>
        <p class="text-sm text-stone-400">Two minutes per source. No engineering required.</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 border border-stone-200 rounded-xl overflow-hidden">
        <div class="bg-white p-7 text-center hover:bg-stone-50 transition-colors border-r border-stone-200">
          <div class="w-10 h-10 rounded-xl mx-auto mb-3 flex items-center justify-center" style="background:#FFF1F0">
            <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="8" stroke="#E01E5A" stroke-width="1.5"/><path d="M7 10h6" stroke="#E01E5A" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <div class="text-[13px] font-semibold text-stone-700">Intercom</div>
          <div class="text-[11px] text-stone-400">Chat & tickets</div>
        </div>
        <div class="bg-white p-7 text-center hover:bg-stone-50 transition-colors border-r border-stone-200">
          <div class="w-10 h-10 rounded-xl mx-auto mb-3 flex items-center justify-center" style="background:#F3EFFF">
            <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none"><rect x="4" y="4" width="12" height="12" rx="2" stroke="#4A154B" stroke-width="1.5"/><path d="M7 10h6M10 7v6" stroke="#4A154B" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <div class="text-[13px] font-semibold text-stone-700">Slack</div>
          <div class="text-[11px] text-stone-400">Channels & threads</div>
        </div>
        <div class="bg-white p-7 text-center hover:bg-stone-50 transition-colors border-r border-stone-200">
          <div class="w-10 h-10 rounded-xl mx-auto mb-3 flex items-center justify-center" style="background:#F0F0F0">
            <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none"><rect x="4" y="4" width="12" height="12" rx="3" stroke="#262626" stroke-width="1.5"/><path d="M7 9h6M7 12h3" stroke="#262626" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <div class="text-[13px] font-semibold text-stone-700">Typeform</div>
          <div class="text-[11px] text-stone-400">Surveys & forms</div>
        </div>
        <div class="bg-white p-7 text-center hover:bg-stone-50 transition-colors border-r border-stone-200">
          <div class="w-10 h-10 rounded-xl mx-auto mb-3 flex items-center justify-center" style="background:#E8F0FE">
            <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none"><path d="M10 5L6 10h3v5l4-5h-3V5z" stroke="#0052CC" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="text-[13px] font-semibold text-stone-700">Jira</div>
          <div class="text-[11px] text-stone-400">Issues & feedback</div>
        </div>
        <div class="bg-white p-7 text-center hover:bg-stone-50 transition-colors border-r border-stone-200">
          <div class="w-10 h-10 rounded-xl mx-auto mb-3 flex items-center justify-center" style="background:#E8F5E9">
            <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none"><path d="M6 10l3 3 5-6" stroke="#4285F4" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="10" r="7" stroke="#4285F4" stroke-width="1.5"/></svg>
          </div>
          <div class="text-[13px] font-semibold text-stone-700">Google Reviews</div>
          <div class="text-[11px] text-stone-400">App & business</div>
        </div>
        <div class="bg-white p-7 text-center hover:bg-stone-50 transition-colors">
          <div class="w-10 h-10 rounded-xl mx-auto mb-3 flex items-center justify-center" style="background:#EEF2FF">
