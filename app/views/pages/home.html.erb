<%# Marketing landing page for non-authenticated users %>
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <title>FeedbackMind — AI-Powered Feedback Intelligence for PMs</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Connect all your feedback sources and get AI-powered insights. FeedbackMind synthesizes Intercom, Gmail, Slack, Jira, and more into actionable themes.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= csrf_meta_tags %>
</head>
<body class="bg-white font-sans text-gray-900 antialiased">

  <!-- Nav -->
  <nav class="fixed top-0 inset-x-0 z-50 bg-white/80 backdrop-blur-xl border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 bg-indigo-500 rounded-lg flex items-center justify-center text-white text-[11px] font-extrabold">FM</div>
        <span class="font-bold text-[15px] tracking-tight">FeedbackMind</span>
      </div>
      <div class="flex items-center gap-6">
        <a href="#features" class="text-[13px] text-gray-500 hover:text-gray-900 transition-colors font-medium">Features</a>
        <a href="#pricing" class="text-[13px] text-gray-500 hover:text-gray-900 transition-colors font-medium">Pricing</a>
        <%= link_to "Sign in", new_user_session_path, class: "text-[13px] text-gray-500 hover:text-gray-900 transition-colors font-medium" %>
        <%= link_to "Get Started", new_user_registration_path, class: "text-[13px] font-semibold bg-indigo-500 text-white px-4 py-1.5 rounded-lg hover:bg-indigo-600 transition-colors" %>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pt-32 pb-20 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 text-[12px] font-medium text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full mb-6">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        Powered by GPT-4.1
      </div>
      <h1 class="text-5xl font-extrabold tracking-tight leading-[1.1] mb-5">
        Turn scattered feedback into
        <span class="text-indigo-500">actionable intelligence</span>
      </h1>
      <p class="text-lg text-gray-500 leading-relaxed mb-8 max-w-xl mx-auto">
        Connect Intercom, Gmail, Slack, Jira, App Store and more. FeedbackMind synthesizes everything into weekly themes, impact scores, and AI-powered answers.
      </p>
      <div class="flex items-center justify-center gap-3">
        <%= link_to new_user_registration_path, class: "inline-flex items-center gap-2 bg-indigo-500 text-white px-6 py-3 rounded-xl font-semibold text-[15px] hover:bg-indigo-600 shadow-lg shadow-indigo-500/20 hover:shadow-xl hover:shadow-indigo-500/25 transition-all hover:-translate-y-0.5" do %>
          Start free trial
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        <% end %>
        <a href="#features" class="inline-flex items-center gap-2 border border-gray-200 text-gray-600 px-6 py-3 rounded-xl font-medium text-[15px] hover:border-gray-300 transition-all">
          See how it works
        </a>
      </div>
      <p class="text-[12px] text-gray-400 mt-4">Free 14-day trial. No credit card required.</p>
    </div>
  </section>

  <!-- Social proof -->
  <section class="pb-16 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-[12px] uppercase tracking-wider text-gray-400 font-semibold mb-6">Trusted by product teams at</p>
      <div class="flex items-center justify-center gap-12 opacity-40">
        <span class="text-xl font-bold">Stripe</span>
        <span class="text-xl font-bold">Vercel</span>
        <span class="text-xl font-bold">Linear</span>
        <span class="text-xl font-bold">Notion</span>
        <span class="text-xl font-bold">Figma</span>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="py-20 px-6 bg-gray-50">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-3xl font-extrabold tracking-tight mb-3">Everything competitors miss</h2>
        <p class="text-gray-500 text-lg">Features that Productboard, Canny, and UserVoice don't have.</p>
      </div>

      <div class="grid grid-cols-3 gap-5">
        <!-- Feature 1 -->
        <div class="bg-white rounded-xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-indigo-50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <h3 class="font-bold text-[15px] mb-2">AI Impact Scoring</h3>
          <p class="text-[13px] text-gray-500 leading-relaxed">Every theme gets an estimated MRR impact. Know exactly how much revenue is at risk from each feedback cluster.</p>
        </div>

        <!-- Feature 2 -->
        <div class="bg-white rounded-xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-emerald-50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <h3 class="font-bold text-[15px] mb-2">Sentiment Timeline</h3>
          <p class="text-[13px] text-gray-500 leading-relaxed">Not just pie charts — see how sentiment evolves daily with spike detection that explains what caused changes.</p>
        </div>

        <!-- Feature 3 -->
        <div class="bg-white rounded-xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h3 class="font-bold text-[15px] mb-2">RAG-Powered Chat</h3>
          <p class="text-[13px] text-gray-500 leading-relaxed">Ask questions about your feedback in natural language. AI searches across all sources and cites specific feedbacks.</p>
        </div>

        <!-- Feature 4 -->
        <div class="bg-white rounded-xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          </div>
          <h3 class="font-bold text-[15px] mb-2">Feedback Pipeline</h3>
          <p class="text-[13px] text-gray-500 leading-relaxed">Visual kanban from Raw Feedback to Shipped. Track every piece of feedback from collection to resolution.</p>
        </div>

        <!-- Feature 5 -->
        <div class="bg-white rounded-xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-purple-50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          </div>
          <h3 class="font-bold text-[15px] mb-2">Closed-Loop Tracker</h3>
          <p class="text-[13px] text-gray-500 leading-relaxed">Know which feedbacks led to shipped features. Track user notifications and post-fix satisfaction rates.</p>
        </div>

        <!-- Feature 6 -->
        <div class="bg-white rounded-xl border border-gray-100 p-6 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-rose-50 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>
          <h3 class="font-bold text-[15px] mb-2">Command Palette</h3>
          <p class="text-[13px] text-gray-500 leading-relaxed">Press ⌘K to search anything instantly. Navigate, trigger actions, and find feedbacks without touching the mouse.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-3xl font-extrabold tracking-tight mb-3">Simple, transparent pricing</h2>
        <p class="text-gray-500 text-lg">Start free, scale as you grow.</p>
      </div>

      <div class="grid grid-cols-3 gap-5">
        <div class="bg-white rounded-xl border border-gray-200 p-6">
          <h3 class="font-bold mb-1">Starter</h3>
          <div class="text-3xl font-extrabold mb-1">$49<span class="text-base font-normal text-gray-400">/mo</span></div>
          <p class="text-[13px] text-gray-400 mb-5">For small teams getting started</p>
          <ul class="space-y-2 text-[13px] text-gray-600 mb-6">
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>500 feedbacks/month</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>3 sources</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Weekly synthesis</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg><span class="text-gray-400">AI Chat</span></li>
          </ul>
          <%= link_to "Get started", new_user_registration_path, class: "block text-center py-2.5 rounded-lg border border-gray-200 text-[13px] font-semibold text-gray-700 hover:bg-gray-50 transition-colors" %>
        </div>

        <div class="bg-white rounded-xl border-2 border-indigo-500 p-6 relative shadow-lg shadow-indigo-500/10">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-indigo-500 text-white text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full">Popular</div>
          <h3 class="font-bold mb-1">Growth</h3>
          <div class="text-3xl font-extrabold mb-1">$149<span class="text-base font-normal text-gray-400">/mo</span></div>
          <p class="text-[13px] text-gray-400 mb-5">For growing product teams</p>
          <ul class="space-y-2 text-[13px] text-gray-600 mb-6">
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>5,000 feedbacks/month</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Unlimited sources</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Weekly synthesis</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>AI Chat (RAG)</li>
          </ul>
          <%= link_to "Get started", new_user_registration_path, class: "block text-center py-2.5 rounded-lg bg-indigo-500 text-white text-[13px] font-semibold hover:bg-indigo-600 transition-colors" %>
        </div>

        <div class="bg-white rounded-xl border border-gray-200 p-6">
          <h3 class="font-bold mb-1">Scale</h3>
          <div class="text-3xl font-extrabold mb-1">$399<span class="text-base font-normal text-gray-400">/mo</span></div>
          <p class="text-[13px] text-gray-400 mb-5">For enterprise teams</p>
          <ul class="space-y-2 text-[13px] text-gray-600 mb-6">
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Unlimited feedbacks</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Unlimited sources</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Daily synthesis</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>Priority support</li>
          </ul>
          <%= link_to "Contact us", new_user_registration_path, class: "block text-center py-2.5 rounded-lg border border-gray-200 text-[13px] font-semibold text-gray-700 hover:bg-gray-50 transition-colors" %>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-gray-100 py-10 px-6">
    <div class="max-w-5xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 bg-indigo-500 rounded-md flex items-center justify-center text-white text-[9px] font-extrabold">FM</div>
        <span class="text-[13px] text-gray-400">FeedbackMind &copy; <%= Date.current.year %></span>
      </div>
      <div class="flex gap-6 text-[13px] text-gray-400">
        <a href="#" class="hover:text-gray-600 transition-colors">Privacy</a>
        <a href="#" class="hover:text-gray-600 transition-colors">Terms</a>
        <a href="#" class="hover:text-gray-600 transition-colors">Docs</a>
      </div>
    </div>
  </footer>

</body>
</html>
