<% content_for(:page_title) { @entry.title } %>

<div class="space-y-6">
  <div class="flex items-center gap-2 text-sm">
    <%= link_to changelog_entries_path, class: "text-stone-900 hover:text-stone-700 font-medium" do %>
      &larr; Changelog
    <% end %>
  </div>

  <!-- Header -->
  <div class="bg-white rounded-xl border border-stone-200 p-6">
    <div class="flex items-start justify-between mb-4">
      <div class="flex-1">
        <div class="flex items-center gap-2 mb-2">
          <h1 class="text-xl font-bold text-stone-900 font-serif-display"><%= @entry.title %></h1>
          <span class="text-xs px-2.5 py-1 rounded-full font-medium <%= @entry.category_color_class %>"><%= @entry.category_emoji %> <%= @entry.category_label %></span>
          <% unless @entry.published? %>
            <span class="text-xs px-2 py-0.5 rounded bg-amber-100 text-amber-700 font-medium">Draft</span>
          <% end %>
        </div>
        <div class="flex items-center gap-3 text-sm text-stone-500">
          <% if @entry.version.present? %>
            <span class="font-mono font-medium text-stone-700"><%= @entry.version %></span>
          <% end %>
          <span><%= @entry.formatted_date %></span>
          <% if @entry.user.present? %>
            <span>by <strong class="text-stone-700"><%= @entry.user.display_name %></strong></span>
          <% end %>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <% if @entry.published? %>
          <%= button_to "Unpublish", unpublish_changelog_entry_path(@entry), method: :post,
              data: { turbo: false },
              class: "px-3 py-2 rounded-lg border border-stone-300 text-stone-600 hover:bg-stone-50 text-sm font-medium transition-colors" %>
        <% else %>
          <%= button_to "Publish", publish_changelog_entry_path(@entry), method: :post,
              data: { turbo: false },
              class: "px-3 py-2 rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 text-sm font-medium transition-colors" %>
        <% end %>
        <%= link_to "Edit", edit_changelog_entry_path(@entry),
            class: "px-3 py-2 rounded-lg border border-stone-300 text-stone-600 hover:bg-stone-50 text-sm font-medium transition-colors" %>
      </div>
    </div>

    <div class="text-sm text-stone-700 leading-relaxed border-t border-stone-200 pt-4">
      <%= simple_format(@entry.body) %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-6">
    <!-- Left: Linked Feature Requests -->
    <div class="bg-white rounded-xl border border-stone-200 p-5">
      <h2 class="text-sm font-bold text-stone-900 mb-3">Linked Feature Requests (<%= @linked_feature_requests.size %>)</h2>
      <% if @linked_feature_requests.any? %>
        <div class="space-y-2 mb-4">
          <% @linked_feature_requests.each do |fr| %>
            <div class="flex items-center justify-between gap-2 p-3 bg-stone-50 rounded-lg border border-stone-200">
              <div class="flex-1 min-w-0">
                <%= link_to fr.title, feature_request_path(fr), class: "text-sm font-medium text-stone-700 hover:text-stone-900 truncate" %>
                <p class="text-xs text-stone-400"><%= fr.votes_count %> votes &middot; <%= fr.status.titleize %></p>
              </div>
              <%= button_to unlink_feature_request_changelog_entry_path(@entry, feature_request_id: fr.id), method: :delete,
                  data: { turbo: false },
                  class: "text-stone-400 hover:text-red-600 transition-colors shrink-0" do %>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @available_feature_requests.any? %>
        <details class="group">
          <summary class="text-sm font-medium text-stone-900 cursor-pointer hover:text-stone-700 list-none flex items-center gap-1">
            <svg class="h-4 w-4 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            Link shipped feature request
          </summary>
          <div class="mt-3 space-y-2 max-h-60 overflow-y-auto">
            <% @available_feature_requests.each do |fr| %>
              <div class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-stone-50">
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-medium text-stone-700 truncate"><%= fr.title %></p>
                  <p class="text-[10px] text-stone-400"><%= fr.votes_count %> votes</p>
                </div>
                <%= button_to "Link", link_feature_request_changelog_entry_path(@entry, feature_request_id: fr.id), method: :post,
                    data: { turbo: false },
                    class: "text-xs px-2.5 py-1 rounded-lg bg-stone-900 text-white hover:bg-stone-800 transition-colors shrink-0" %>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>

    <!-- Right: Danger Zone -->
    <div class="bg-white rounded-xl border border-red-200 p-5">
      <h2 class="text-sm font-bold text-red-600 mb-3">Danger Zone</h2>
      <%= button_to "Delete Entry", changelog_entry_path(@entry), method: :delete,
          data: { turbo: false, turbo_confirm: "Permanently delete this changelog entry?" },
          class: "w-full px-4 py-2 rounded-lg border border-red-300 text-red-600 hover:bg-red-50 text-sm font-medium transition-colors" %>
    </div>
  </div>
</div>
