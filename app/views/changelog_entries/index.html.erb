<% content_for(:page_title) { "Changelog" } %>
<% content_for(:topbar_actions) do %>
  <div class="flex items-center gap-2">
    <% if current_account.portal_enabled? && current_account.subdomain.present? %>
      <%= link_to portal_changelog_path(portal_subdomain: current_account.subdomain), target: "_blank",
          class: "inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-stone-300 text-stone-700 hover:bg-stone-50 transition-colors text-sm font-medium" do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
        View Public
      <% end %>
    <% end %>
    <%= link_to new_changelog_entry_path, class: "inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-stone-900 text-white hover:bg-stone-800 transition-colors font-medium text-sm" do %>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
      New Entry
    <% end %>
  </div>
<% end %>

<div class="space-y-6">
  <!-- Tabs -->
  <div class="flex flex-wrap gap-2">
    <%= link_to changelog_entries_path,
        class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{params[:visibility].blank? ? 'bg-stone-900 text-white' : 'bg-white text-stone-600 border border-stone-300 hover:bg-stone-50'}" do %>
      All <span class="ml-1 opacity-70"><%= @total_count %></span>
    <% end %>
    <%= link_to changelog_entries_path(visibility: "published"),
        class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{params[:visibility] == 'published' ? 'bg-stone-900 text-white' : 'bg-white text-stone-600 border border-stone-300 hover:bg-stone-50'}" do %>
      Published <span class="ml-1 opacity-70"><%= @published_count %></span>
    <% end %>
    <%= link_to changelog_entries_path(visibility: "draft"),
        class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{params[:visibility] == 'draft' ? 'bg-stone-900 text-white' : 'bg-white text-stone-600 border border-stone-300 hover:bg-stone-50'}" do %>
      Drafts <span class="ml-1 opacity-70"><%= @draft_count %></span>
    <% end %>
  </div>

  <!-- List -->
  <% if @entries.any? %>
    <div class="space-y-3">
      <% @entries.each do |entry| %>
        <div class="bg-white rounded-xl border border-stone-200 p-5 hover:shadow-sm transition-shadow">
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <%= link_to entry.title, changelog_entry_path(entry), class: "text-base font-semibold text-stone-900 hover:text-stone-700" %>
                <span class="text-xs px-2 py-0.5 rounded-full font-medium <%= entry.category_color_class %>"><%= entry.category_emoji %> <%= entry.category_label %></span>
                <% unless entry.published? %>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-100 text-amber-700 font-medium">Draft</span>
                <% end %>
              </div>
              <div class="flex items-center gap-3 text-xs text-stone-400">
                <% if entry.version.present? %>
                  <span class="font-mono font-medium text-stone-500"><%= entry.version %></span>
                <% end %>
                <span><%= entry.formatted_date %></span>
                <% if entry.feature_requests.any? %>
                  <span><%= entry.feature_requests.count %> linked requests</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl border border-stone-200 p-12 text-center">
      <svg class="mx-auto h-12 w-12 text-stone-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
      <h3 class="text-lg font-semibold text-stone-900 mb-2">No changelog entries yet</h3>
      <p class="text-sm text-stone-500 mb-6">Share product updates with your users.</p>
      <%= link_to "New Entry", new_changelog_entry_path, class: "px-4 py-2 rounded-lg bg-stone-900 text-white hover:bg-stone-800 transition-colors font-medium text-sm" %>
    </div>
  <% end %>
</div>
