<% content_for(:page_title) { "Loop Tracker" } %>

<div class="space-y-6">
  <!-- Stats -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="bg-white rounded-xl border border-stone-200 p-6">
      <div class="text-4xl font-bold text-stone-900 mb-2">
        <%= @stats&.dig(:total_resolved) || 0 %>
      </div>
      <p class="text-sm text-stone-600">Items Resolved</p>
    </div>

    <div class="bg-white rounded-xl border border-stone-200 p-6">
      <div class="text-4xl font-bold text-emerald-600 mb-2">
        <% satisfaction = @stats&.dig(:satisfaction_rate) || 0 %>
        <%= satisfaction %>%
      </div>
      <p class="text-sm text-stone-600">Satisfaction Rate</p>
    </div>

    <div class="bg-white rounded-xl border border-stone-200 p-6">
      <div class="text-4xl font-bold text-blue-600 mb-2">
        <% days = @stats&.dig(:avg_days_to_resolve) || 0 %>
        <%= days.round(1) %>
      </div>
      <p class="text-sm text-stone-600">Avg Days to Resolve</p>
    </div>
  </div>

  <!-- Status sections -->
  <div class="space-y-6">
    <!-- Shipped -->
    <div class="bg-white rounded-xl border border-stone-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-stone-200 bg-emerald-50">
        <h2 class="text-lg font-bold text-stone-900">
          ✓ Shipped
          <span class="text-stone-600 font-normal ml-2">
            <%= @shipped_items&.count || 0 %> items
          </span>
        </h2>
      </div>

      <% if (@shipped_items || []).any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="border-b border-stone-200 bg-stone-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wide">Feature</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wide">Linked Feedbacks</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wide">Users Notified</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wide">Satisfaction</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wide">Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-200">
              <% (@shipped_items || []).each do |item| %>
                <tr class="hover:bg-stone-50 transition-colors">
                  <td class="px-6 py-4 text-sm font-medium text-stone-900">
                    <%= item.name %>
                  </td>
                  <td class="px-6 py-4 text-sm text-stone-600">
                    <span class="inline-flex items-center gap-1 px-2 py-1 rounded bg-stone-100 text-stone-700 font-medium">
                      <%= item.feedback_count || 0 %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm text-stone-600">
                    <span class="font-semibold text-stone-900">
                      <%= item.users_notified || 0 %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm">
                    <div class="flex items-center gap-2">
                      <div class="w-16 bg-stone-200 rounded-full h-2">
                        <div class="bg-emerald-500 h-2 rounded-full" style="width: <%= item.satisfaction_percent || 0 %>%"></div>
                      </div>
                      <span class="text-xs font-semibold text-stone-900">
                        <%= item.satisfaction_percent || 0 %>%
                      </span>
                    </div>
                  </td>
                  <td class="px-6 py-4 text-sm text-stone-600">
                    <%= format_time_ago(item.shipped_at) if item.respond_to?(:shipped_at) && item.shipped_at.present? %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-8 text-center text-stone-500">
          <p class="text-sm">No shipped items yet</p>
        </div>
      <% end %>
    </div>

    <!-- In Progress -->
    <div class="bg-white rounded-xl border border-stone-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-stone-200 bg-amber-50">
        <h2 class="text-lg font-bold text-stone-900">
          🔄 In Progress
          <span class="text-stone-600 font-normal ml-2">
            <%= @in_progress_items&.count || 0 %> items
          </span>
        </h2>
      </div>

      <% if (@in_progress_items || []).any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="border-b border-stone-200 bg-stone-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wide">Feature</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wide">Linked Feedbacks</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wide">Users Notified</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wide">Progress</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wide">Started</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-200">
              <% (@in_progress_items || []).each do |item| %>
                <tr class="hover:bg-stone-50 transition-colors">
                  <td class="px-6 py-4 text-sm font-medium text-stone-900">
                    <%= item.name %>
                  </td>
                  <td class="px-6 py-4 text-sm text-stone-600">
                    <span class="inline-flex items-center gap-1 px-2 py-1 rounded bg-stone-100 text-stone-700 font-medium">
                      <%= item.feedback_count || 0 %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm text-stone-600">
                    <span class="font-semibold text-stone-900">
                      <%= item.users_notified || 0 %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm">
                    <div class="flex items-center gap-2">
                      <div class="w-16 bg-stone-200 rounded-full h-2">
                        <div class="bg-amber-500 h-2 rounded-full" style="width: <%= item.progress_percent || 0 %>%"></div>
                      </div>
                      <span class="text-xs font-semibold text-stone-900">
                        <%= item.progress_percent || 0 %>%
                      </span>
                    </div>
                  </td>
                  <td class="px-6 py-4 text-sm text-stone-600">
                    <%= format_time_ago(item.started_at) if item.respond_to?(:started_at) && item.started_at.present? %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-8 text-center text-stone-500">
          <p class="text-sm">No items in progress</p>
        </div>
      <% end %>
    </div>

    <!-- Planned -->
    <div class="bg-white rounded-xl border border-stone-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-stone-200 bg-blue-50">
        <h2 class="text-lg font-bold text-stone-900">
          📋 Planned
          <span class="text-stone-600 font-normal ml-2">
            <%= @planned_items&.count || 0 %> items
          </span>
        </h2>
      </div>

      <% if (@planned_items || []).any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="border-b border-stone-200 bg-stone-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wide">Feature</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wide">Linked Feedbacks</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wide">Users Interested</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-stone-600 uppercase tracking-wide">Planned Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-200">
              <% (@planned_items || []).each do |item| %>
                <tr class="hover:bg-stone-50 transition-colors">
                  <td class="px-6 py-4 text-sm font-medium text-stone-900">
                    <%= item.name %>
                  </td>
                  <td class="px-6 py-4 text-sm text-stone-600">
                    <span class="inline-flex items-center gap-1 px-2 py-1 rounded bg-stone-100 text-stone-700 font-medium">
                      <%= item.feedback_count || 0 %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm text-stone-600">
                    <span class="font-semibold text-stone-900">
                      <%= item.users_interested || 0 %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm text-stone-600">
                    <%= item.planned_date&.strftime("%b %d, %Y") || "TBD" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-8 text-center text-stone-500">
          <p class="text-sm">No planned items</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
