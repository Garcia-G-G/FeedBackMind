<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <%= link_to nps_surveys_path, class: "text-sm text-stone-900 hover:text-stone-700 font-medium" do %>
      &larr; NPS Surveys
    <% end %>
  </div>

  <div class="bg-white rounded-xl border border-stone-200 p-6">
    <h2 class="text-xl font-bold text-stone-900 font-serif-display mb-6"><%= survey.new_record? ? "New NPS Survey" : "Edit NPS Survey" %></h2>

    <%= form_with model: survey, data: { turbo: false } do |f| %>
      <% if survey.errors.any? %>
        <div class="mb-4 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800">
          <ul class="list-disc list-inside">
            <% survey.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-5">
        <div>
          <label class="block text-sm font-semibold text-stone-700 mb-1">Survey Name <span class="text-red-500">*</span></label>
          <%= f.text_field :name, placeholder: "e.g., Product NPS Q1 2026",
              class: "w-full px-4 py-2.5 rounded-lg border border-stone-300 text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent",
              required: true %>
        </div>

        <div>
          <label class="block text-sm font-semibold text-stone-700 mb-1">Question</label>
          <%= f.text_field :question, placeholder: "How likely are you to recommend us?",
              class: "w-full px-4 py-2.5 rounded-lg border border-stone-300 text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent" %>
        </div>

        <div>
          <label class="block text-sm font-semibold text-stone-700 mb-1">Follow-up Question</label>
          <%= f.text_field :followup_question, placeholder: "What's the main reason for your score?",
              class: "w-full px-4 py-2.5 rounded-lg border border-stone-300 text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent" %>
        </div>

        <div>
          <label class="block text-sm font-semibold text-stone-700 mb-1">Thank You Message</label>
          <%= f.text_field :thank_you_message, placeholder: "Thanks for your feedback!",
              class: "w-full px-4 py-2.5 rounded-lg border border-stone-300 text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent" %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-stone-700 mb-1">Brand Color</label>
            <div class="flex items-center gap-2">
              <%= f.color_field :brand_color, class: "w-10 h-10 rounded-lg border border-stone-300 cursor-pointer" %>
              <%= f.text_field :brand_color, class: "flex-1 px-4 py-2.5 rounded-lg border border-stone-300 text-sm font-mono text-stone-900 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent" %>
            </div>
          </div>
          <div>
            <label class="block text-sm font-semibold text-stone-700 mb-1">Position</label>
            <%= f.select :position,
                [["Bottom Right", "bottom-right"], ["Bottom Left", "bottom-left"]],
                {}, class: "w-full px-4 py-2.5 rounded-lg border border-stone-300 text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent" %>
          </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <%= link_to "Cancel", nps_surveys_path,
              class: "px-4 py-2.5 rounded-lg border border-stone-300 text-sm font-medium text-stone-700 hover:bg-stone-50 transition-colors" %>
          <%= f.submit survey.new_record? ? "Create Survey" : "Update Survey",
              class: "px-5 py-2.5 rounded-lg bg-stone-900 text-white text-sm font-semibold hover:bg-stone-800 transition-colors cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
