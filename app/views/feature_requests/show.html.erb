<% content_for(:page_title) { @feature_request.title } %>

<div class="space-y-6">
  <!-- Back -->
  <div class="flex items-center gap-2 text-sm">
    <%= link_to feature_requests_path, class: "text-stone-900 hover:text-stone-700 font-medium" do %>
      &larr; Feature Requests
    <% end %>
  </div>

  <!-- Header Card -->
  <div class="bg-white rounded-xl border border-stone-200 p-6">
    <div class="flex items-start justify-between mb-4">
      <div class="flex-1">
        <div class="flex items-center gap-2 mb-2">
          <h1 class="text-xl font-bold text-stone-900 font-serif-display"><%= @feature_request.title %></h1>
          <span class="text-xs px-2.5 py-1 rounded-full font-medium <%= @feature_request.status_color_class %>"><%= @feature_request.status.titleize %></span>
          <% unless @feature_request.published? %>
            <span class="text-xs px-2 py-0.5 rounded bg-amber-100 text-amber-700 font-medium">Draft</span>
          <% end %>
        </div>
        <div class="flex items-center gap-3 text-sm text-stone-500">
          <span>by <strong class="text-stone-700"><%= @feature_request.author_name.presence || @feature_request.author_email %></strong></span>
          <span><%= format_time_ago(@feature_request.created_at) %></span>
          <span class="font-bold text-stone-900"><%= @feature_request.votes_count %> votes</span>
          <% if @feature_request.category.present? %>
            <span class="px-2 py-0.5 rounded bg-stone-100 text-stone-500 text-xs"><%= @feature_request.category %></span>
          <% end %>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <% if @feature_request.published? %>
          <%= button_to "Unpublish", unpublish_feature_request_path(@feature_request), method: :post,
              data: { turbo: false },
              class: "px-3 py-2 rounded-lg border border-stone-300 text-stone-600 hover:bg-stone-50 text-sm font-medium transition-colors" %>
        <% else %>
          <%= button_to "Publish", publish_feature_request_path(@feature_request), method: :post,
              data: { turbo: false },
              class: "px-3 py-2 rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 text-sm font-medium transition-colors" %>
        <% end %>
        <%= link_to "Edit", edit_feature_request_path(@feature_request),
            class: "px-3 py-2 rounded-lg border border-stone-300 text-stone-600 hover:bg-stone-50 text-sm font-medium transition-colors" %>
      </div>
    </div>

    <% if @feature_request.description.present? %>
      <div class="text-sm text-stone-700 leading-relaxed whitespace-pre-wrap border-t border-stone-200 pt-4"><%= @feature_request.description %></div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-6">
    <!-- Left Column -->
    <div class="space-y-6">
      <!-- Quick Status Change -->
      <div class="bg-white rounded-xl border border-stone-200 p-5">
        <h2 class="text-sm font-bold text-stone-900 mb-3">Status</h2>
        <%= form_with model: @feature_request, url: feature_request_path(@feature_request), method: :patch, data: { turbo: false } do |f| %>
          <div class="flex items-center gap-2">
            <%= f.select :status, FeatureRequest.statuses.keys.map { |s| [s.titleize, s] },
                {}, class: "flex-1 px-3 py-2 rounded-lg border border-stone-300 text-sm focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent" %>
            <%= f.submit "Update", class: "px-4 py-2 rounded-lg bg-stone-900 text-white text-sm font-medium hover:bg-stone-800 transition-colors cursor-pointer" %>
          </div>
        <% end %>
      </div>

      <!-- Linked Feedbacks -->
      <div class="bg-white rounded-xl border border-stone-200 p-5">
        <h2 class="text-sm font-bold text-stone-900 mb-3">Linked Feedbacks (<%= @linked_feedbacks.size %>)</h2>
        <% if @linked_feedbacks.any? %>
          <div class="space-y-2 mb-4">
            <% @linked_feedbacks.each do |fb| %>
              <div class="flex items-start justify-between gap-2 p-3 bg-stone-50 rounded-lg border border-stone-200">
                <div class="flex-1 min-w-0">
                  <p class="text-sm text-stone-700 line-clamp-2"><%= fb.content.truncate(120) %></p>
                  <p class="text-xs text-stone-400 mt-1"><%= fb.source&.source_type&.titleize %> &middot; <%= format_time_ago(fb.received_at) %></p>
                </div>
                <%= button_to unlink_feedback_feature_request_path(@feature_request, feedback_id: fb.id), method: :delete,
                    data: { turbo: false, turbo_confirm: "Unlink this feedback?" },
                    class: "text-stone-400 hover:text-red-600 transition-colors shrink-0" do %>
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if @available_feedbacks.any? %>
          <details class="group">
            <summary class="text-sm font-medium text-stone-900 cursor-pointer hover:text-stone-700 list-none flex items-center gap-1">
              <svg class="h-4 w-4 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              Link feedback
            </summary>
            <div class="mt-3 space-y-2 max-h-60 overflow-y-auto">
              <% @available_feedbacks.each do |fb| %>
                <div class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-stone-50">
                  <p class="text-xs text-stone-600 truncate flex-1"><%= fb.content.truncate(80) %></p>
                  <%= button_to "Link", link_feedback_feature_request_path(@feature_request, feedback_id: fb.id), method: :post,
                      data: { turbo: false },
                      class: "text-xs px-2.5 py-1 rounded-lg bg-stone-900 text-white hover:bg-stone-800 transition-colors shrink-0" %>
                </div>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>

      <!-- Admin Notes -->
      <div class="bg-white rounded-xl border border-stone-200 p-5">
        <h2 class="text-sm font-bold text-stone-900 mb-3">Admin Notes</h2>
        <%= form_with model: @feature_request, url: feature_request_path(@feature_request), method: :patch, data: { turbo: false } do |f| %>
          <%= f.text_area :admin_notes, rows: 4, placeholder: "Internal notes (not visible on portal)...",
              class: "w-full px-3 py-2 rounded-lg border border-stone-300 text-sm text-stone-700 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent resize-y mb-2" %>
          <%= f.submit "Save Notes", class: "px-4 py-2 rounded-lg bg-stone-900 text-white text-sm font-medium hover:bg-stone-800 transition-colors cursor-pointer" %>
        <% end %>
      </div>
    </div>

    <!-- Right Column -->
    <div class="space-y-6">
      <!-- Recent Voters -->
      <div class="bg-white rounded-xl border border-stone-200 p-5">
        <h2 class="text-sm font-bold text-stone-900 mb-3">Recent Voters (<%= @feature_request.votes_count %>)</h2>
        <% if @recent_voters.any? %>
          <div class="space-y-3">
            <% @recent_voters.each do |vote| %>
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-stone-100 flex items-center justify-center text-xs font-bold text-stone-600 shrink-0">
                  <%= vote.voter_email.first(2).upcase %>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-stone-700 truncate"><%= vote.voter_name.presence || vote.voter_email %></p>
                  <p class="text-xs text-stone-400"><%= format_time_ago(vote.created_at) %></p>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-stone-400">No votes yet.</p>
        <% end %>
      </div>

      <!-- Merge -->
      <div class="bg-white rounded-xl border border-stone-200 p-5">
        <h2 class="text-sm font-bold text-stone-900 mb-3">Merge Duplicate</h2>
        <p class="text-xs text-stone-500 mb-3">Merge this request into another. Votes and linked feedbacks will transfer.</p>
        <% if @merge_candidates.any? %>
          <div class="space-y-2 max-h-48 overflow-y-auto">
            <% @merge_candidates.each do |candidate| %>
              <div class="flex items-center justify-between gap-2 p-2 rounded-lg hover:bg-stone-50">
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-medium text-stone-700 truncate"><%= candidate.title %></p>
                  <p class="text-[10px] text-stone-400"><%= candidate.votes_count %> votes</p>
                </div>
                <%= button_to "Merge", merge_feature_request_path(@feature_request, target_id: candidate.id), method: :post,
                    data: { turbo: false, turbo_confirm: "Merge \"#{@feature_request.title}\" into \"#{candidate.title}\"? This cannot be undone." },
                    class: "text-xs px-2.5 py-1 rounded-lg border border-stone-300 text-stone-600 hover:bg-stone-100 transition-colors shrink-0" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-stone-400">No other requests to merge into.</p>
        <% end %>
      </div>

      <!-- Danger Zone -->
      <div class="bg-white rounded-xl border border-red-200 p-5">
        <h2 class="text-sm font-bold text-red-600 mb-3">Danger Zone</h2>
        <%= button_to "Delete Request", feature_request_path(@feature_request), method: :delete,
            data: { turbo: false, turbo_confirm: "Permanently delete \"#{@feature_request.title}\"? This cannot be undone." },
            class: "w-full px-4 py-2 rounded-lg border border-red-300 text-red-600 hover:bg-red-50 text-sm font-medium transition-colors" %>
      </div>
    </div>
  </div>
</div>
