<div class="bg-white rounded-xl border border-stone-200 p-6 mb-6 shadow-sm">
  <%= form_with url: onboarding_path, method: :patch, local: true, id: "workspace-form" do %>
    <% if current_account.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-sm text-red-800 mb-5">
        <% current_account.errors.full_messages.each do |msg| %>
          <p>&bull; <%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="mb-5">
      <label class="block text-sm font-medium text-stone-700 mb-2">Workspace Name</label>
      <input
        type="text"
        name="account[name]"
        value="<%= current_account.name %>"
        placeholder="Acme Product Team"
        autofocus
        class="w-full px-4 py-3 rounded-xl border border-stone-300 text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500"
      >
    </div>

    <div>
      <label class="block text-sm font-medium text-stone-700 mb-2">Workspace URL</label>
      <div class="flex items-center rounded-xl border border-stone-300 overflow-hidden focus-within:ring-2 focus-within:ring-stone-900/10">
        <span class="px-3 py-3 bg-stone-50 text-stone-400 text-sm border-r border-stone-300">https://</span>
        <input
          type="text"
          name="account[subdomain]"
          value="<%= current_account.subdomain %>"
          placeholder="acme"
          class="flex-1 px-3 py-3 text-stone-900 placeholder-stone-400 focus:outline-none"
        >
        <span class="px-3 py-3 bg-stone-50 text-stone-400 text-sm border-l border-stone-300">.feedbackmind.io</span>
      </div>
      <p class="text-xs text-stone-400 mt-1.5">Lowercase letters, numbers, and hyphens only</p>
    </div>

    <div class="flex gap-3 mt-6">
      <%= form_with url: onboarding_path, method: :patch, local: true, class: "inline" do %>
        <input type="hidden" name="back" value="true">
        <button type="submit" class="px-5 py-3 rounded-xl border border-stone-300 text-stone-600 hover:bg-stone-100 font-medium">←</button>
      <% end %>
      <button
        type="submit"
        class="flex-1 py-3 rounded-xl bg-stone-900 text-white hover:bg-stone-800 font-medium transition-all shadow-lg shadow-stone-900/20"
      >
        Continue →
      </button>
    </div>
  <% end %>
</div>
