<div class="bg-white rounded-xl border border-gray-100 shadow-sm p-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-2">Connect your first source</h1>
  <p class="text-sm text-gray-500 mb-6">Where does your customer feedback come from? You can add more later.</p>

  <div class="grid grid-cols-2 gap-4 mb-6">
    <%
      sources = [
        { provider: "slack", emoji: "💼", name: "Slack", desc: "Feedback from channels" },
        { provider: "gmail", emoji: "📧", name: "Gmail", desc: "Customer emails" },
        { provider: "intercom", emoji: "💬", name: "Intercom", desc: "Chat conversations" },
        { provider: "jira", emoji: "🔧", name: "Jira", desc: "Issues & comments" },
        { provider: "typeform", emoji: "📋", name: "Typeform", desc: "Survey responses" },
        { provider: "csv", emoji: "📄", name: "CSV Upload", desc: "Import from file" }
      ]
    %>
    <% sources.each do |src| %>
      <% if src[:provider] == "csv" %>
        <%= link_to new_source_path, class: "flex items-center gap-3 p-4 rounded-xl border border-gray-200 hover:border-indigo-300 hover:bg-indigo-50/30 transition-all" do %>
          <div class="text-2xl"><%= src[:emoji] %></div>
          <div>
            <p class="font-semibold text-sm text-gray-900"><%= src[:name] %></p>
            <p class="text-xs text-gray-500"><%= src[:desc] %></p>
          </div>
        <% end %>
      <% else %>
        <%= button_to connect_source_path(provider: src[:provider]), method: :post, class: "flex items-center gap-3 p-4 rounded-xl border border-gray-200 hover:border-indigo-300 hover:bg-indigo-50/30 transition-all text-left w-full" do %>
          <div class="text-2xl"><%= src[:emoji] %></div>
          <div>
            <p class="font-semibold text-sm text-gray-900"><%= src[:name] %></p>
            <p class="text-xs text-gray-500"><%= src[:desc] %></p>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="flex items-center justify-between pt-4 border-t border-gray-100">
    <%= form_with url: onboarding_path, method: :patch, local: true do %>
      <button type="submit" class="text-sm text-gray-500 hover:text-gray-700 font-medium">Skip for now →</button>
    <% end %>
  </div>
</div>
