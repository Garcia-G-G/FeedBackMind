<div class="bg-white rounded-xl border border-gray-100 shadow-sm p-8 text-center">
  <div class="mb-6">
    <div class="w-16 h-16 bg-emerald-50 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <h1 class="text-2xl font-bold text-gray-900 mb-2">You're all set!</h1>
    <p class="text-sm text-gray-500">Your workspace <strong class="text-gray-900"><%= current_account.name %></strong> is ready to go.</p>
  </div>

  <!-- Plan summary -->
  <div class="bg-gray-50 rounded-xl p-5 mb-6 text-left">
    <h3 class="text-sm font-bold text-gray-900 mb-3">Your plan: <span class="text-indigo-600"><%= current_account.plan.titleize %></span></h3>
    <div class="grid grid-cols-3 gap-4 text-center">
      <div>
        <p class="text-lg font-bold text-gray-900"><%= current_account.plan_limits[:feedbacks_per_month] == Float::INFINITY ? '∞' : number_with_delimiter(current_account.plan_limits[:feedbacks_per_month]) %></p>
        <p class="text-xs text-gray-500">Feedbacks/mo</p>
      </div>
      <div>
        <p class="text-lg font-bold text-gray-900"><%= current_account.plan_limits[:sources] == Float::INFINITY ? '∞' : current_account.plan_limits[:sources] %></p>
        <p class="text-xs text-gray-500">Sources</p>
      </div>
      <div>
        <p class="text-lg font-bold text-gray-900"><%= current_account.plan_limits[:chat_enabled] ? '✓' : '—' %></p>
        <p class="text-xs text-gray-500">AI Chat</p>
      </div>
    </div>
  </div>

  <!-- Quick summary -->
  <div class="text-left space-y-2 mb-6">
    <div class="flex items-center gap-2 text-sm">
      <div class="w-5 h-5 bg-emerald-50 rounded-full flex items-center justify-center"><svg class="w-3 h-3 text-emerald-500" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
      <span class="text-gray-700">Workspace: <strong><%= current_account.subdomain %>.feedbackmind.io</strong></span>
    </div>
    <div class="flex items-center gap-2 text-sm">
      <div class="w-5 h-5 bg-emerald-50 rounded-full flex items-center justify-center"><svg class="w-3 h-3 text-emerald-500" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
      <span class="text-gray-700">Sources connected: <strong><%= current_account.sources.active.count %></strong></span>
    </div>
  </div>

  <%= form_with url: onboarding_path, method: :patch, local: true do %>
    <button type="submit" class="w-full px-6 py-3 rounded-lg bg-indigo-500 text-white font-bold text-base hover:bg-indigo-600 transition-colors shadow-lg shadow-indigo-500/20">
      Go to Dashboard →
    </button>
  <% end %>
</div>
