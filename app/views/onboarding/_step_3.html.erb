<%
  sources = [
    { id: "slack", name: "Slack", icon: "💬", color: "#E8D5B7" },
    { id: "gmail", name: "Gmail", icon: "📧", color: "#D5E8D4" },
    { id: "jira", name: "Jira", icon: "🔧", color: "#D4D5E8" },
    { id: "typeform", name: "Typeform", icon: "📋", color: "#E8D4D4" },
    { id: "appstore", name: "App Store", icon: "🍎", color: "#D4E8E8" },
    { id: "csv", name: "CSV Upload", icon: "📄", color: "#E8E8D4" }
  ]
%>

<div data-controller="source-selector">
  <div class="grid grid-cols-2 gap-3 mb-6">
    <% sources.each do |source| %>
      <button
        type="button"
        data-source="<%= source[:id] %>"
        data-action="click->source-selector#toggle"
        class="source-card flex items-center gap-3 p-4 rounded-xl border-2 transition-all text-left border-stone-200 bg-white hover:border-stone-300"
      >
        <div class="w-10 h-10 rounded-lg flex items-center justify-center text-xl flex-shrink-0" style="background-color: <%= source[:color] %>">
          <%= source[:icon] %>
        </div>
        <div class="flex-1 min-w-0">
          <div class="font-medium text-stone-900 text-sm"><%= source[:name] %></div>
          <div class="source-selected-label hidden text-emerald-600 text-xs font-medium mt-0.5">Selected</div>
        </div>
        <div class="source-check w-5 h-5 rounded-full border-2 flex items-center justify-center flex-shrink-0 border-stone-300">
        </div>
      </button>
    <% end %>
  </div>

  <div class="bg-stone-100 rounded-xl p-3 mb-6 text-center">
    <p class="text-stone-500 text-xs">
      Connections are made securely from your <strong>Sources</strong> dashboard. No popups during setup.
    </p>
  </div>

  <%= form_with url: onboarding_path, method: :patch, local: true, id: "sources-form" do %>
    <input type="hidden" name="selected_sources" id="selected-sources" value="">
    <div class="flex gap-3">
      <%= form_with url: onboarding_path, method: :patch, local: true, class: "inline" do %>
        <input type="hidden" name="back" value="true">
        <button type="submit" class="px-5 py-3 rounded-xl border border-stone-300 text-stone-600 hover:bg-stone-100 font-medium">←</button>
      <% end %>
      <button
        type="submit"
        class="flex-1 py-3 rounded-xl bg-stone-900 text-white hover:bg-stone-800 font-medium transition-all shadow-lg shadow-stone-900/20"
      >
        Launch workspace →
      </button>
    </div>
  <% end %>

  <button
    type="button"
    data-action="click->source-selector#skip"
    class="w-full text-center text-sm text-stone-400 mt-4 hover:text-stone-600 transition-colors"
  >
    Skip — I'll add sources later
  </button>
</div>
