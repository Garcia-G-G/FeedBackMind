<div class="bg-white rounded-xl border border-stone-200 shadow-sm p-8">
  <h1 class="text-2xl font-bold font-serif-display text-stone-900 mb-2">Set up your workspace</h1>
  <p class="text-sm text-stone-500 mb-6">Choose a name and URL for your team's feedback hub.</p>

  <%= form_with url: onboarding_path, method: :patch, local: true, class: "space-y-5" do |f| %>
    <% if current_account.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-sm text-red-800">
        <% current_account.errors.full_messages.each do |msg| %>
          <p>&bull; <%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <label class="block text-sm font-semibold text-stone-900 mb-1.5">Workspace Name</label>
      <input type="text" name="account[name]" value="<%= current_account.name %>" placeholder="Acme Inc." autofocus
        class="w-full px-4 py-2.5 border border-stone-300 rounded-lg focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500 outline-none transition">
    </div>

    <div>
      <label class="block text-sm font-semibold text-stone-900 mb-1.5">Workspace URL</label>
      <div class="flex items-center">
        <input type="text" name="account[subdomain]" value="<%= current_account.subdomain %>" placeholder="acme"
          class="flex-1 px-4 py-2.5 border border-stone-300 rounded-l-lg focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500 outline-none transition">
        <span class="px-4 py-2.5 bg-stone-100 border border-l-0 border-stone-300 rounded-r-lg text-sm text-stone-500 font-medium">.feedbackmind.io</span>
      </div>
      <p class="text-xs text-stone-400 mt-1">Lowercase letters, numbers, and hyphens only</p>
    </div>

    <div class="flex justify-end pt-4">
      <button type="submit" class="px-6 py-2.5 rounded-lg bg-stone-900 text-white font-semibold hover:bg-stone-800 transition-colors">
        Continue →
      </button>
    </div>
  <% end %>
</div>
