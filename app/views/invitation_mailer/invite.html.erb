<div style="max-width: 560px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1c1917;">
  <div style="padding: 32px 24px; text-align: center; border-bottom: 1px solid #e7e5e4;">
    <div style="display: inline-block; background-color: #1c1917; border-radius: 10px; padding: 10px 14px; margin-bottom: 16px;">
      <span style="color: #ffffff; font-weight: 800; font-size: 16px;">FM</span>
    </div>
    <h1 style="font-size: 22px; font-weight: 700; margin: 0 0 8px; color: #1c1917;">You've been invited!</h1>
    <p style="font-size: 14px; color: #78716c; margin: 0;">
      <strong><%= @inviter.display_name %></strong> has invited you to join <strong><%= @account.name %></strong> on FeedbackMind.
    </p>
  </div>

  <div style="padding: 32px 24px; text-align: center;">
    <p style="font-size: 14px; color: #57534e; margin: 0 0 8px;">
      You've been invited as a <strong><%= @invitation.role.titleize %></strong>.
    </p>
    <p style="font-size: 14px; color: #57534e; margin: 0 0 24px; line-height: 1.5;">
      Click the button below to create your account and join the team.
    </p>

    <a href="<%= accept_invitation_url(token: @invitation.token) %>"
       style="display: inline-block; padding: 12px 32px; background-color: #1c1917; color: #ffffff; text-decoration: none; border-radius: 10px; font-size: 14px; font-weight: 600;">
      Accept Invitation
    </a>

    <p style="font-size: 12px; color: #a8a29e; margin: 24px 0 0;">
      This invitation expires in 7 days. If you didn't expect this, you can safely ignore this email.
    </p>
  </div>

  <div style="padding: 24px; border-top: 1px solid #e7e5e4; text-align: center;">
    <p style="font-size: 12px; color: #a8a29e; margin: 0;">FeedbackMind &mdash; Centralize, analyze, and act on customer feedback</p>
  </div>
</div>
