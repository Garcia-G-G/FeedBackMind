<nav class="fixed top-0 left-0 bottom-0 w-[252px] bg-white border-r border-stone-200 flex flex-col z-50" data-controller="sidebar">
  <!-- Logo + Search -->
  <div class="px-4 pt-5 pb-4">
    <div class="flex items-center gap-2.5 mb-5">
      <div class="w-[30px] h-[30px] bg-stone-900 rounded-lg flex items-center justify-center text-white text-[13px] font-extrabold shrink-0">FM</div>
      <span class="font-bold text-[15px] tracking-tight">FeedbackMind</span>
    </div>

    <!-- Command Palette Trigger -->
    <button
      class="flex items-center gap-2 w-full px-2.5 py-2 bg-stone-50 border border-stone-200 rounded-lg text-[13px] text-stone-400 hover:border-stone-300 hover:bg-stone-100 transition-all"
      data-action="click->command-palette#open"
    >
      <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      Search anything...
      <kbd class="ml-auto text-[11px] text-stone-300 border border-stone-200 px-1.5 py-0.5 rounded font-medium">⌘K</kbd>
    </button>
  </div>

  <!-- Role Switcher -->
  <div class="px-2.5 mb-2" data-controller="role-switcher">
    <div class="flex gap-0.5 p-0.5 bg-stone-100 rounded-lg">
      <button class="role-btn flex-1 py-1.5 text-center text-[11px] font-semibold rounded-md transition-all bg-white text-stone-900 shadow-sm" data-role-switcher-target="btn" data-action="click->role-switcher#switch" data-role="pm">PM</button>
      <button class="role-btn flex-1 py-1.5 text-center text-[11px] font-semibold rounded-md transition-all text-stone-400" data-role-switcher-target="btn" data-action="click->role-switcher#switch" data-role="eng">Eng</button>
      <button class="role-btn flex-1 py-1.5 text-center text-[11px] font-semibold rounded-md transition-all text-stone-400" data-role-switcher-target="btn" data-action="click->role-switcher#switch" data-role="exec">Exec</button>
    </div>
  </div>

  <!-- Navigation -->
  <div class="px-2.5 py-3">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-stone-400 px-1.5 pb-2">Overview</p>
    <%= sidebar_link "Dashboard", dashboard_path, "dashboard", controller_name == "dashboard" %>
    <%= sidebar_link "Feedbacks", feedbacks_path, "feedback", controller_name == "feedbacks", badge: current_account&.feedbacks&.count %>
    <%= sidebar_link "Syntheses", syntheses_path, "syntheses", controller_name == "syntheses" %>
    <%= sidebar_link "Pipeline", pipeline_path, "pipeline", controller_name == "pipeline", badge_warn: current_account&.feedbacks&.unprocessed&.count %>
  </div>

  <div class="px-2.5 py-3">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-stone-400 px-1.5 pb-2">Manage</p>
    <%= sidebar_link "Requests", feature_requests_path, "requests", controller_name == "feature_requests", badge: current_account&.feature_requests&.not_merged&.count %>
    <%= sidebar_link "Companies", companies_path, "companies", controller_name == "companies", badge: current_account&.companies&.count %>
    <%= sidebar_link "NPS", nps_surveys_path, "nps", controller_name == "nps_surveys" %>
    <%= sidebar_link "Changelog", changelog_entries_path, "changelog", controller_name == "changelog_entries" %>
    <%= sidebar_link "Sources", sources_path, "sources", controller_name == "sources" %>
    <%= sidebar_link "Loop Tracker", loop_tracker_path, "loop_tracker", controller_name == "loop_tracker" %>
    <%= sidebar_link "Settings", settings_path, "settings", controller_name == "settings" %>
  </div>

  <!-- Footer: User -->
  <div class="mt-auto px-4 py-3.5 border-t border-stone-200 flex items-center gap-2.5">
    <div class="w-[30px] h-[30px] rounded-full bg-stone-100 flex items-center justify-center text-[12px] font-bold text-stone-700 shrink-0">
      <%= current_user&.email&.first(2)&.upcase %>
    </div>
    <div class="flex-1 min-w-0">
      <div class="text-[13px] font-semibold truncate"><%= current_account&.name || "My Team" %></div>
      <div class="text-[11px] text-stone-400 capitalize"><%= current_account&.plan || "starter" %> Plan</div>
    </div>
    <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "text-stone-300 hover:text-stone-500 transition-colors" do %>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
    <% end %>
  </div>
</nav>
