<header class="sticky top-0 z-40 bg-stone-50/80 backdrop-blur-xl border-b border-stone-200 px-7 h-[52px] flex items-center justify-between">
  <div class="flex items-center gap-4">
    <h1 class="text-base font-serif-display font-normal tracking-tight"><%= yield(:page_title) || controller_name.titleize %></h1>

    <% if content_for?(:period_selector) %>
      <%= yield(:period_selector) %>
    <% else %>
      <div class="flex gap-0.5 p-0.5 bg-stone-100 rounded-lg" data-controller="period-selector">
        <button class="px-3 py-1 text-[12px] font-medium rounded-md bg-white text-stone-900 shadow-sm transition-all" data-period-selector-target="btn" data-action="click->period-selector#select" data-period="7">7 days</button>
        <button class="px-3 py-1 text-[12px] font-medium rounded-md text-stone-400 transition-all" data-period-selector-target="btn" data-action="click->period-selector#select" data-period="30">30 days</button>
        <button class="px-3 py-1 text-[12px] font-medium rounded-md text-stone-400 transition-all" data-period-selector-target="btn" data-action="click->period-selector#select" data-period="90">Quarter</button>
      </div>
    <% end %>
  </div>

  <div class="flex items-center gap-2">
    <% if content_for?(:topbar_actions) %>
      <%= yield(:topbar_actions) %>
    <% else %>
      <button class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[12px] font-medium border border-stone-200 bg-white text-stone-500 hover:border-stone-300 hover:text-stone-700 transition-all">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Export
      </button>
      <%= link_to new_synthesis_path, class: "inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-[12px] font-medium bg-stone-900 text-white hover:bg-stone-800 transition-all" do %>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        Generate Synthesis
      <% end %>
    <% end %>
  </div>
</header>
