<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <title><%= content_for?(:title) ? "#{yield(:title)} — FeedbackMind" : "FeedbackMind" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">

  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
</head>
<body class="h-full bg-stone-50 font-sans text-stone-900 antialiased">
  <% if user_signed_in? %>
    <%= render "layouts/sidebar" %>
    <div class="ml-[252px] min-h-screen flex flex-col">
      <%= render "layouts/topbar" %>
      <main class="flex-1 px-7 py-6">
        <% if notice.present? %>
          <div class="mb-4 rounded-lg bg-emerald-50 border border-emerald-200 px-4 py-3 text-sm text-emerald-800" data-controller="dismissible" data-action="click->dismissible#dismiss">
            <%= notice %>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="mb-4 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800" data-controller="dismissible" data-action="click->dismissible#dismiss">
            <%= alert %>
          </div>
        <% end %>
        <%= yield %>
      </main>
    </div>

    <%= render "shared/command_palette" %>
    <%= render "shared/chat_panel" %>
  <% else %>
    <main>
      <%= yield %>
    </main>
  <% end %>
</body>
</html>
