<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <title>Setup — FeedbackMind</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Serif+Display&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
</head>
<body class="h-full font-sans text-stone-900 antialiased">
  <div class="min-h-screen flex">
    <!-- LEFT PANEL -->
    <div class="w-[420px] bg-stone-900 p-10 flex flex-col justify-between flex-shrink-0">
      <div>
        <div class="flex items-center gap-3 mb-16">
          <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center text-stone-900 text-xs font-extrabold">FM</div>
          <span class="text-lg font-semibold text-white font-serif-display">FeedbackMind</span>
        </div>

        <% step = @step || 1 %>
        <%
          step_data = {
            1 => { title: "Choose your plan", subtitle: "Start with a 14-day free trial", description: "Every plan includes feedback collection, sentiment analysis, and weekly AI syntheses. Upgrade or downgrade anytime." },
            2 => { title: "Create workspace", subtitle: "Your team's feedback hub", description: "Choose a name and URL for your workspace. This is where your team will access FeedbackMind." },
            3 => { title: "Connect sources", subtitle: "Where does feedback come from?", description: "Connect the tools your team uses to collect feedback. You can always add more from the Sources dashboard." }
          }
          info = step_data[step]
        %>

        <div class="text-xs font-medium text-stone-500 uppercase tracking-wider mb-3">Step <%= step %> of 3</div>
        <h1 class="text-2xl font-bold text-white font-serif-display mb-2"><%= info[:title] %></h1>
        <p class="text-emerald-400 text-sm font-medium mb-4"><%= info[:subtitle] %></p>
        <p class="text-stone-400 text-sm leading-relaxed"><%= info[:description] %></p>

        <div class="mt-8">
          <% if step == 1 %>
            <div class="space-y-3">
              <% ["Centralize all feedback", "AI-powered insights", "Track what you ship"].each do |item| %>
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center text-emerald-400">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  </div>
                  <span class="text-stone-300 text-sm"><%= item %></span>
                </div>
              <% end %>
            </div>
          <% elsif step == 2 %>
            <div class="bg-white/5 rounded-xl p-4 border border-white/10">
              <div class="flex items-center gap-2 mb-3">
                <div class="w-6 h-6 bg-emerald-500/20 rounded flex items-center justify-center text-emerald-400 text-xs font-bold">FM</div>
                <span class="text-stone-300 text-sm font-medium"><%= current_account.name.presence || "Your Workspace" %></span>
              </div>
              <% if current_account.plan.present? %>
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-xs text-stone-500">Plan:</span>
                  <span class="text-xs font-semibold text-emerald-400"><%= current_account.plan.titleize %></span>
                </div>
              <% end %>
              <div class="text-xs text-stone-500 leading-relaxed">
                Your workspace URL will be where your team accesses FeedbackMind every day.
              </div>
            </div>
            <div class="mt-4 space-y-2">
              <div class="flex items-center gap-2 text-stone-400 text-xs">
                <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                Unique URL for your team
              </div>
              <div class="flex items-center gap-2 text-stone-400 text-xs">
                <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                Can be changed later in Settings
              </div>
              <div class="flex items-center gap-2 text-stone-400 text-xs">
                <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                Invite team members after setup
              </div>
            </div>
          <% elsif step == 3 %>
            <% connected_count = current_account.sources.where(active: true).count %>
            <% if connected_count > 0 %>
              <div class="bg-emerald-500/10 rounded-xl p-4 border border-emerald-500/20">
                <div class="flex items-center gap-2 text-emerald-400 text-sm font-medium mb-2">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  <%= connected_count %> source<%= connected_count > 1 ? "s" : "" %> connected
                </div>
                <% current_account.sources.where(active: true).each do |s| %>
                  <div class="text-stone-400 text-xs"><%= s.source_type.titleize %></div>
                <% end %>
              </div>
            <% else %>
              <div class="text-stone-500 text-sm italic">Connect your tools on the right</div>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="flex gap-2">
        <% [1, 2, 3].each do |s| %>
          <div class="h-1 rounded-full flex-1 <%= s <= step ? 'bg-emerald-500' : 'bg-white/10' %>"></div>
        <% end %>
      </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="flex-1 bg-stone-50 flex items-center justify-center p-10">
      <div class="w-full max-w-md">
        <% if notice.present? %>
          <div class="mb-4 rounded-xl bg-emerald-50 border border-emerald-200 px-4 py-3 text-sm text-emerald-800"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="mb-4 rounded-xl bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800"><%= alert %></div>
        <% end %>
        <%= yield %>
      </div>
    </div>
  </div>
</body>
</html>
