<div data-controller="command-palette" data-action="keydown@window->command-palette#handleKeydown" class="hidden">
  <!-- Overlay -->
  <div data-command-palette-target="overlay" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[1000] flex items-start justify-center pt-[18vh]" data-action="click->command-palette#closeOnOverlay">
    <!-- Box -->
    <div data-command-palette-target="box" class="w-[560px] bg-white rounded-2xl shadow-2xl border border-stone-200 overflow-hidden animate-scale-in">
      <!-- Input -->
      <div class="flex items-center gap-2.5 px-4 py-3.5 border-b border-stone-200">
        <svg class="w-[18px] h-[18px] text-stone-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input
          data-command-palette-target="input"
          data-action="input->command-palette#filter"
          type="text"
          class="flex-1 border-none bg-transparent text-[15px] outline-none placeholder-stone-300"
          placeholder="Search feedbacks, themes, actions..."
          autocomplete="off"
        >
        <kbd class="text-[10px] text-stone-300 border border-stone-200 px-1.5 py-0.5 rounded">ESC</kbd>
      </div>

      <!-- Results -->
      <div data-command-palette-target="results" class="max-h-[320px] overflow-y-auto p-1.5">
        <!-- Quick Actions -->
        <p class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider px-3 pt-2 pb-1">Quick Actions</p>
        <a href="<%= syntheses_path %>" class="cmd-result flex items-center gap-2.5 px-3 py-2 rounded-lg hover:bg-stone-100 transition-colors cursor-pointer" data-command-palette-target="result">
          <svg class="w-4 h-4 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span class="text-[13px] font-medium">Generate weekly synthesis</span>
          <span class="ml-auto text-[11px] text-stone-400">Action</span>
        </a>
        <button class="cmd-result flex items-center gap-2.5 px-3 py-2 rounded-lg hover:bg-stone-100 transition-colors cursor-pointer w-full text-left" data-command-palette-target="result" data-action="click->command-palette#openChat">
          <svg class="w-4 h-4 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span class="text-[13px] font-medium">Ask AI about feedback</span>
          <span class="ml-auto text-[11px] text-stone-400">AI Chat</span>
        </button>

        <!-- Navigation -->
        <p class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider px-3 pt-3 pb-1">Navigation</p>
        <a href="<%= dashboard_path %>" class="cmd-result flex items-center gap-2.5 px-3 py-2 rounded-lg hover:bg-stone-100 transition-colors" data-command-palette-target="result">
          <svg class="w-4 h-4 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          <span class="text-[13px] font-medium">Go to Dashboard</span>
          <span class="ml-auto text-[11px] text-stone-400">Page</span>
        </a>
        <a href="<%= feedbacks_path %>" class="cmd-result flex items-center gap-2.5 px-3 py-2 rounded-lg hover:bg-stone-100 transition-colors" data-command-palette-target="result">
          <svg class="w-4 h-4 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span class="text-[13px] font-medium">Go to Feedbacks</span>
          <span class="ml-auto text-[11px] text-stone-400">Page</span>
        </a>
        <a href="<%= sources_path %>" class="cmd-result flex items-center gap-2.5 px-3 py-2 rounded-lg hover:bg-stone-100 transition-colors" data-command-palette-target="result">
          <svg class="w-4 h-4 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span class="text-[13px] font-medium">Go to Sources</span>
          <span class="ml-auto text-[11px] text-stone-400">Page</span>
        </a>
        <a href="<%= pipeline_path %>" class="cmd-result flex items-center gap-2.5 px-3 py-2 rounded-lg hover:bg-stone-100 transition-colors" data-command-palette-target="result">
          <svg class="w-4 h-4 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          <span class="text-[13px] font-medium">Go to Pipeline</span>
          <span class="ml-auto text-[11px] text-stone-400">Page</span>
        </a>
        <a href="<%= settings_path %>" class="cmd-result flex items-center gap-2.5 px-3 py-2 rounded-lg hover:bg-stone-100 transition-colors" data-command-palette-target="result">
          <svg class="w-4 h-4 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          <span class="text-[13px] font-medium">Go to Settings</span>
          <span class="ml-auto text-[11px] text-stone-400">Page</span>
        </a>
      </div>

      <!-- Footer -->
      <div class="px-4 py-2.5 border-t border-stone-200 flex gap-4">
        <span class="text-[11px] text-stone-400 flex items-center gap-1"><kbd class="text-[10px] border border-stone-200 px-1 py-0.5 rounded bg-stone-50 font-sans">↑</kbd><kbd class="text-[10px] border border-stone-200 px-1 py-0.5 rounded bg-stone-50 font-sans">↓</kbd> Navigate</span>
        <span class="text-[11px] text-stone-400 flex items-center gap-1"><kbd class="text-[10px] border border-stone-200 px-1 py-0.5 rounded bg-stone-50 font-sans">↵</kbd> Select</span>
        <span class="text-[11px] text-stone-400 flex items-center gap-1"><kbd class="text-[10px] border border-stone-200 px-1 py-0.5 rounded bg-stone-50 font-sans">esc</kbd> Close</span>
      </div>
    </div>
  </div>
</div>
