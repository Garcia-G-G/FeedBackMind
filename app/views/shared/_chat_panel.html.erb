<%# AI Chat FAB + Panel %>
<div data-controller="chat-panel">
  <!-- FAB Button -->
  <button
    data-action="click->chat-panel#toggle"
    data-chat-panel-target="fab"
    class="fixed bottom-6 right-6 inline-flex items-center gap-2 px-[18px] py-3 rounded-full bg-stone-900 text-white text-[13px] font-semibold shadow-lg shadow-stone-900/25 z-[60] hover:-translate-y-0.5 hover:shadow-xl hover:shadow-stone-900/30 transition-all"
  >
    <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    Ask AI
    <span class="w-[7px] h-[7px] rounded-full bg-emerald-400 animate-pulse"></span>
  </button>

  <!-- Chat Panel -->
  <div
    data-chat-panel-target="panel"
    class="hidden fixed bottom-[76px] right-6 w-[400px] h-[520px] bg-white rounded-2xl shadow-2xl border border-stone-200 flex-col z-[59] overflow-hidden"
  >
    <!-- Header -->
    <div class="px-[18px] py-3.5 border-b border-stone-200 flex items-center justify-between">
      <h3 class="text-[14px] font-bold flex items-center gap-2">
        <svg class="w-4 h-4 text-stone-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        FeedbackMind AI
        <span class="text-[9px] font-bold bg-indigo-50 text-indigo-500 px-1.5 py-0.5 rounded-md uppercase">RAG</span>
      </h3>
      <button data-action="click->chat-panel#toggle" class="p-1 rounded text-stone-400 hover:bg-stone-50 hover:text-stone-600 transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <!-- Suggestions -->
    <div class="px-[18px] pt-3 flex gap-1.5 flex-wrap">
      <button data-action="click->chat-panel#useSuggestion" class="text-[11px] px-2.5 py-1 border border-stone-200 rounded-full bg-white text-stone-500 hover:border-stone-400 hover:text-stone-900 hover:bg-stone-100 transition-all cursor-pointer">What's the biggest risk?</button>
      <button data-action="click->chat-panel#useSuggestion" class="text-[11px] px-2.5 py-1 border border-stone-200 rounded-full bg-white text-stone-500 hover:border-stone-400 hover:text-stone-900 hover:bg-stone-100 transition-all cursor-pointer">Summarize checkout issues</button>
      <button data-action="click->chat-panel#useSuggestion" class="text-[11px] px-2.5 py-1 border border-stone-200 rounded-full bg-white text-stone-500 hover:border-stone-400 hover:text-stone-900 hover:bg-stone-100 transition-all cursor-pointer">Compare vs last week</button>
    </div>

    <!-- Messages -->
    <div data-chat-panel-target="messages" class="flex-1 overflow-y-auto px-[18px] py-3 flex flex-col gap-2.5">
      <div class="max-w-[85%] text-[13px] leading-relaxed px-3.5 py-2.5 rounded-xl rounded-bl bg-stone-50 self-start">
        I have access to your feedback data across all connected sources. Ask me anything about patterns, sentiment trends, or revenue impact.
      </div>
    </div>

    <!-- Compose -->
    <div class="px-3.5 py-3 border-t border-stone-200 flex gap-2" data-action="submit->chat-panel#send">
      <input
        data-chat-panel-target="input"
        data-action="keydown.enter->chat-panel#send"
        type="text"
        class="flex-1 px-3 py-2 border border-stone-200 rounded-lg text-[13px] outline-none focus:border-stone-400 focus:ring-2 focus:ring-stone-500/10 transition-all placeholder-stone-300"
        placeholder="Ask about your feedback data..."
      >
      <button data-action="click->chat-panel#send" class="w-9 h-9 rounded-lg bg-stone-900 flex items-center justify-center hover:bg-stone-800 transition-colors shrink-0">
        <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </div>
  </div>
</div>
