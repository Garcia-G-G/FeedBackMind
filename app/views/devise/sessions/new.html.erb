<% content_for(:page_title) { "Sign In" } %>

<div class="min-h-screen bg-stone-50 flex items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
  <div class="w-full max-w-md">
    <!-- Logo/Header -->
    <div class="text-center mb-8">
      <div class="flex justify-center mb-4">
        <div class="h-12 w-12 bg-stone-900 rounded-lg flex items-center justify-center">
          <svg class="h-7 w-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
      </div>
      <h1 class="text-2xl font-bold font-serif-display text-stone-900">FeedbackMind</h1>
      <p class="text-sm text-stone-500 mt-2">Centralize, analyze, and act on customer feedback</p>
    </div>

    <!-- Sign in card -->
    <div class="bg-white rounded-xl border border-stone-200 shadow-sm p-8">
      <% if alert.present? %>
        <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-800 flex items-start gap-2">
          <svg class="w-4 h-4 text-red-500 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/></svg>
          <%= alert %>
        </div>
      <% end %>
      <% if notice.present? %>
        <div class="mb-4 p-3 bg-emerald-50 border border-emerald-200 rounded-lg text-sm text-emerald-800">
          <%= notice %>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), local: true, html: { novalidate: true }) do |f| %>
        <div class="space-y-4">
          <!-- Email field -->
          <div>
            <%= f.label :email, "Email address", class: "block text-sm font-semibold text-stone-900 mb-1.5" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "w-full px-4 py-2.5 border border-stone-300 rounded-lg focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500 outline-none transition" %>
          </div>

          <!-- Password field -->
          <div data-controller="password-visibility">
            <%= f.label :password, "Password", class: "block text-sm font-semibold text-stone-900 mb-1.5" %>
            <div style="position:relative">
              <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", data: { password_visibility_target: "input" }, class: "w-full px-4 py-2.5 pr-11 border border-stone-300 rounded-lg focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500 outline-none transition" %>
              <button type="button" data-action="click->password-visibility#toggle" style="position:absolute;right:12px;top:50%;transform:translateY(-50%)" class="text-stone-400 hover:text-stone-600 transition-colors" tabindex="-1">
                <svg data-password-visibility-target="iconShow" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg data-password-visibility-target="iconHide" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
          </div>

          <!-- Remember me -->
          <% if devise_mapping.rememberable? %>
            <div class="flex items-center">
              <%= f.check_box :remember_me, class: "h-4 w-4 text-stone-900 border-stone-300 rounded cursor-pointer" %>
              <%= f.label :remember_me, "Remember me", class: "ml-2 text-sm text-stone-700 cursor-pointer" %>
            </div>
          <% end %>

          <!-- Sign in button -->
          <%= f.submit "Sign in", class: "w-full mt-6 px-4 py-2.5 rounded-lg bg-stone-900 text-white font-semibold hover:bg-stone-800 transition-colors cursor-pointer" %>
        </div>
      <% end %>

      <!-- Divider -->
      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-stone-200"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-2 bg-white text-stone-500">Or</span>
        </div>
      </div>

      <!-- Sign up and forgot password links -->
      <div class="space-y-2 text-sm text-center">
        <div>
          <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-stone-900 hover:text-stone-700 underline font-medium" %>
        </div>
        <div class="text-stone-500">
          Don't have an account?
          <%= link_to "Sign up", new_registration_path(resource_name), class: "text-stone-900 hover:text-stone-700 underline font-semibold" %>
        </div>
      </div>
    </div>

    <!-- Footer info -->
    <p class="text-xs text-stone-500 text-center mt-6">
      By signing in, you agree to our
      <%= link_to "Terms of Service", "#", class: "text-stone-900 hover:text-stone-700 underline" %>
      and
      <%= link_to "Privacy Policy", "#", class: "text-stone-900 hover:text-stone-700 underline" %>
    </p>
  </div>
</div>
