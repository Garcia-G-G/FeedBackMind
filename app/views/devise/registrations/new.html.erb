<% content_for(:page_title) { "Sign Up" } %>

<div class="min-h-screen bg-stone-50 flex items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
  <div class="w-full max-w-md">
    <!-- Logo/Header -->
    <div class="text-center mb-8">
      <div class="flex justify-center mb-4">
        <div class="h-12 w-12 bg-stone-900 rounded-lg flex items-center justify-center">
          <svg class="h-7 w-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
      </div>
      <h1 class="text-2xl font-bold font-serif-display text-stone-900">Create Account</h1>
      <p class="text-sm text-stone-500 mt-2">Start centralizing your customer feedback today</p>
    </div>

    <!-- Sign up card -->
    <div class="bg-white rounded-xl border border-stone-200 shadow-sm p-8">
      <% if alert.present? %>
        <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-800 flex items-start gap-2">
          <svg class="w-4 h-4 text-red-500 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/></svg>
          <%= alert %>
        </div>
      <% end %>

      <% if ENV["GOOGLE_CLIENT_ID"].present? %>
        <div class="mb-6">
          <%= button_to user_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: false },
              class: "w-full flex items-center justify-center gap-3 px-4 py-2.5 border border-stone-300 rounded-lg hover:bg-stone-50 transition-colors font-medium text-sm text-stone-700" do %>
            <svg class="w-5 h-5" viewBox="0 0 24 24">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A11.96 11.96 0 001 12c0 1.94.46 3.77 1.18 5.07l3.66-2.84z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Sign up with Google
          <% end %>
        </div>
        <div class="relative mb-6">
          <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-stone-200"></div></div>
          <div class="relative flex justify-center text-sm"><span class="px-2 bg-white text-stone-500">Or sign up with email</span></div>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), local: true, html: { novalidate: true }) do |f| %>
        <% if resource.errors.any? %>
          <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg">
            <p class="text-sm font-semibold text-red-900 mb-2">
              <%= pluralize(resource.errors.count, "error") %> prohibited this sign up:
            </p>
            <ul class="text-sm text-red-800 space-y-1">
              <% resource.errors.full_messages.each do |message| %>
                <li>• <%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="space-y-4">
          <!-- Name field -->
          <div>
            <%= f.label :name, "Your Name", class: "block text-sm font-semibold text-stone-900 mb-1.5" %>
            <%= f.text_field :name, autofocus: true, placeholder: "Jane Doe", class: "w-full px-4 py-2.5 border border-stone-300 rounded-lg focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500 outline-none transition" %>
          </div>

          <!-- Email field -->
          <div>
            <%= f.label :email, "Email address", class: "block text-sm font-semibold text-stone-900 mb-1.5" %>
            <%= f.email_field :email, autocomplete: "email", placeholder: "you@example.com", class: "w-full px-4 py-2.5 border border-stone-300 rounded-lg focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500 outline-none transition" %>
          </div>

          <!-- Password field -->
          <div data-controller="password-visibility">
            <%= f.label :password, "Password", class: "block text-sm font-semibold text-stone-900 mb-1.5" %>
            <% if @minimum_password_length %>
              <em class="text-xs text-stone-500">(<%= @minimum_password_length %> characters minimum)</em>
            <% end %>
            <div style="position:relative">
              <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••", data: { password_visibility_target: "input" }, class: "w-full px-4 py-2.5 pr-11 border border-stone-300 rounded-lg focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500 outline-none transition" %>
              <button type="button" data-action="click->password-visibility#toggle" style="position:absolute;right:12px;top:50%;transform:translateY(-50%)" class="text-stone-400 hover:text-stone-600 transition-colors" tabindex="-1">
                <svg data-password-visibility-target="iconShow" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg data-password-visibility-target="iconHide" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
          </div>

          <!-- Password confirmation field -->
          <div data-controller="password-visibility">
            <%= f.label :password_confirmation, "Confirm Password", class: "block text-sm font-semibold text-stone-900 mb-1.5" %>
            <div style="position:relative">
              <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", data: { password_visibility_target: "input" }, class: "w-full px-4 py-2.5 pr-11 border border-stone-300 rounded-lg focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500 outline-none transition" %>
              <button type="button" data-action="click->password-visibility#toggle" style="position:absolute;right:12px;top:50%;transform:translateY(-50%)" class="text-stone-400 hover:text-stone-600 transition-colors" tabindex="-1">
                <svg data-password-visibility-target="iconShow" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg data-password-visibility-target="iconHide" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
          </div>

          <!-- Sign up button -->
          <%= f.submit "Create Account", class: "w-full mt-6 px-4 py-2.5 rounded-lg bg-stone-900 text-white font-semibold hover:bg-stone-800 transition-colors cursor-pointer" %>
        </div>
      <% end %>

      <!-- Sign in link -->
      <div class="text-center mt-6 text-sm text-stone-500">
        Already have an account?
        <%= link_to "Sign in", new_session_path(resource_name), class: "text-stone-900 hover:text-stone-700 underline font-semibold" %>
      </div>
    </div>

    <!-- Terms -->
    <p class="text-xs text-stone-500 text-center mt-6">
      By creating an account, you agree to our
      <%= link_to "Terms of Service", "#", class: "text-stone-900 hover:text-stone-700 underline" %>
      and
      <%= link_to "Privacy Policy", "#", class: "text-stone-900 hover:text-stone-700 underline" %>
    </p>
  </div>
</div>
