<% content_for(:page_title) { @source.name } %>

<div class="space-y-6">
  <!-- Back link -->
  <div class="flex items-center gap-2 text-sm">
    <%= link_to sources_path, class: "text-stone-900 hover:text-stone-700 font-medium" do %>
      ← Sources
    <% end %>
  </div>

  <!-- Header -->
  <div class="bg-white rounded-xl border border-stone-200 p-6">
    <div class="flex items-start gap-4 mb-6">
      <div class="text-5xl">
        <%= source_emoji(@source.source_type) %>
      </div>
      <div class="flex-1">
        <div class="flex items-center gap-3 mb-2">
          <h1 class="text-2xl font-bold text-stone-900 font-serif-display">
            <%= @source.name %>
          </h1>
          <span class="text-xs px-3 py-1.5 rounded-full bg-stone-100 text-stone-700 font-medium uppercase tracking-wide">
            <%= @source.source_type.titleize %>
          </span>
        </div>
        <p class="text-sm text-stone-600">
          Connected <%= format_time_ago(@source.created_at) %>
        </p>
      </div>
      <div class="text-right">
        <div class="flex items-center gap-2 mb-2">
          <span class="<%= @source.active? ? 'bg-emerald-500' : 'bg-stone-300' %> h-3 w-3 rounded-full"></span>
          <span class="font-semibold text-stone-900">
            <%= @source.active? ? 'Active' : 'Inactive' %>
          </span>
        </div>
      </div>
    </div>

    <!-- Details -->
    <div class="grid grid-cols-3 gap-6 border-t border-stone-200 pt-6">
      <div>
        <p class="text-xs font-semibold text-stone-600 uppercase tracking-wide mb-1">Status</p>
        <p class="text-base font-semibold text-stone-900">
          <%= @source.active? ? '🟢 Connected' : '🔴 Disconnected' %>
        </p>
      </div>
      <div>
        <p class="text-xs font-semibold text-stone-600 uppercase tracking-wide mb-1">Total Feedbacks</p>
        <p class="text-base font-semibold text-stone-900">
          <%= @source.feedback_count || 0 %>
        </p>
      </div>
      <div>
        <p class="text-xs font-semibold text-stone-600 uppercase tracking-wide mb-1">Last Synced</p>
        <p class="text-base font-semibold text-stone-900">
          <% if @source.last_synced_at.present? %>
            <%= format_time_ago(@source.last_synced_at) %>
          <% else %>
            Never
          <% end %>
        </p>
      </div>
    </div>
  </div>

  <!-- Credentials -->
  <div class="bg-white rounded-xl border border-stone-200 p-6">
    <h2 class="text-lg font-bold text-stone-900 mb-4">Credentials</h2>
    <div class="bg-stone-50 rounded-lg p-4 font-mono text-sm text-stone-700 break-all">
      <% if @source.credentials.present? %>
        <span class="text-stone-500">••••••••••••••••••••••••••••••••</span>
      <% else %>
        <span class="text-stone-500 italic">No credentials stored</span>
      <% end %>
    </div>
  </div>

  <!-- Recent Feedbacks -->
  <div class="bg-white rounded-xl border border-stone-200 p-6">
    <h2 class="text-lg font-bold text-stone-900 mb-4">Recent Feedbacks</h2>

    <% if @source.feedbacks.present? %>
      <div class="space-y-3">
        <% @source.feedbacks.limit(10).each do |feedback| %>
          <div class="flex items-start gap-4 pb-3 border-b border-stone-200 last:border-0 last:pb-0">
            <div class="flex-1">
              <p class="text-sm font-medium text-stone-900 mb-1">
                <%= feedback.title %>
              </p>
              <p class="text-sm text-stone-600 line-clamp-2">
                <%= feedback.content %>
              </p>
            </div>
            <div class="text-right flex-shrink-0">
              <p class="text-xs text-stone-500">
                <%= format_time_ago(feedback.created_at) %>
              </p>
              <% sentiment_class = sentiment_color(feedback.sentiment) %>
              <p class="text-xs font-semibold mt-1 <%= sentiment_class %>">
                <%= feedback.sentiment.titleize %>
              </p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8">
        <p class="text-stone-600">No feedbacks from this source yet.</p>
      </div>
    <% end %>
  </div>

  <!-- Sentiment Breakdown -->
  <% if @source.feedbacks.present? %>
    <div class="bg-white rounded-xl border border-stone-200 p-6">
      <h2 class="text-lg font-bold text-stone-900 mb-4">Sentiment Breakdown</h2>

      <% sentiments = @source.feedbacks.group(:sentiment).count %>
      <% total = sentiments.values.sum %>

      <div class="space-y-3">
        <% sentiments.each do |sentiment, count| %>
          <% percentage = (count.to_f / total * 100).round(0) %>
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-sm font-medium text-stone-700">
                <%= sentiment.titleize %>
              </span>
              <span class="text-sm font-semibold text-stone-900">
                <%= count %> (<%= percentage %>%)
              </span>
            </div>
            <div class="w-full bg-stone-100 rounded-full h-2 overflow-hidden">
              <% color_class = case sentiment
                when 'positive' then 'bg-emerald-500'
                when 'neutral' then 'bg-blue-500'
                else 'bg-red-500'
              end %>
              <div class="<%= color_class %> h-full" style="width: <%= percentage %>%"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
