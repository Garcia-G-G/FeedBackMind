<% content_for(:page_title) { "Add Source" } %>

<div class="max-w-3xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Back to Sources", sources_path, class: "text-stone-900 hover:text-stone-700 font-medium text-sm" %>
  </div>

  <h1 class="text-2xl font-bold text-stone-900 mb-2">Connect a Source</h1>
  <p class="text-sm text-stone-500 mb-8">Choose where your customer feedback comes from.</p>

  <!-- OAuth Sources -->
  <div class="grid grid-cols-2 gap-4 mb-8">
    <%
      oauth_sources = [
        { provider: "slack", emoji: "💼", name: "Slack", desc: "Collect feedback from Slack channels" },
        { provider: "gmail", emoji: "📧", name: "Gmail", desc: "Import feedback from email conversations" },
        { provider: "intercom", emoji: "💬", name: "Intercom", desc: "Sync conversations and feedback" },
        { provider: "jira", emoji: "🔧", name: "Jira", desc: "Import issues and comments as feedback" },
        { provider: "typeform", emoji: "📋", name: "Typeform", desc: "Collect survey responses automatically" },
      ]
    %>
    <% oauth_sources.each do |src| %>
      <div class="bg-white rounded-xl border border-stone-200 p-5 flex items-start gap-4 hover:shadow-sm transition-shadow">
        <div class="text-3xl"><%= src[:emoji] %></div>
        <div class="flex-1">
          <h3 class="font-semibold text-stone-900"><%= src[:name] %></h3>
          <p class="text-xs text-stone-500 mt-1 mb-3"><%= src[:desc] %></p>
          <% existing = current_account.sources.find_by(source_type: src[:provider]) %>
          <% if existing&.active? %>
            <span class="inline-flex items-center gap-1 text-xs font-medium text-emerald-700 bg-emerald-50 px-2 py-1 rounded-full">
              <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span> Connected
            </span>
          <% else %>
            <%= button_to "Connect", connect_source_path(provider: src[:provider]), method: :post, class: "px-4 py-1.5 rounded-lg bg-stone-900 text-white text-xs font-medium hover:bg-stone-800 transition-colors" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- App Store (manual) -->
    <div class="bg-white rounded-xl border border-stone-200 p-5 flex items-start gap-4 hover:shadow-sm transition-shadow">
      <div class="text-3xl">⭐</div>
      <div class="flex-1">
        <h3 class="font-semibold text-stone-900">App Store</h3>
        <p class="text-xs text-stone-500 mt-1 mb-3">Scrape iOS App Store reviews automatically</p>
        <%= form_with url: sources_path, method: :post, local: true, class: "flex gap-2" do |f| %>
          <%= hidden_field_tag "source[source_type]", "appstore" %>
          <input type="text" name="source[config][app_id]" placeholder="App ID" class="flex-1 px-3 py-1.5 border border-stone-200 rounded-lg text-xs focus:ring-2 focus:ring-stone-500 focus:border-transparent">
          <button type="submit" class="px-3 py-1.5 rounded-lg bg-stone-900 text-white text-xs font-medium hover:bg-stone-800 transition-colors">Add</button>
        <% end %>
      </div>
    </div>
  </div>

  <!-- CSV Import -->
  <div class="bg-white rounded-xl border border-stone-200 p-6">
    <div class="flex items-start gap-4 mb-5">
      <div class="text-3xl">📄</div>
      <div>
        <h3 class="font-semibold text-stone-900">CSV Import</h3>
        <p class="text-xs text-stone-500 mt-1">Upload a CSV file with your feedback data</p>
      </div>
    </div>

    <%= form_with url: import_csv_source_path, method: :post, multipart: true, local: true, class: "space-y-4" do %>
      <div>
        <label class="block text-sm font-medium text-stone-700 mb-2">Select CSV file</label>
        <input type="file" name="file" accept=".csv,text/csv" class="block w-full text-sm text-stone-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-stone-100 file:text-stone-700 hover:file:bg-stone-200">
      </div>

      <div class="bg-stone-50 rounded-lg p-4">
        <p class="text-xs font-semibold text-stone-700 mb-2">Required columns:</p>
        <code class="text-xs text-stone-700 bg-stone-100 px-2 py-1 rounded">content</code>
        <p class="text-xs text-stone-500 mt-2">Optional: <code class="text-xs">author_name</code>, <code class="text-xs">author_email</code>, <code class="text-xs">external_id</code>, <code class="text-xs">received_at</code></p>
      </div>

      <button type="submit" class="px-6 py-2.5 rounded-lg bg-stone-900 text-white font-medium text-sm hover:bg-stone-800 transition-colors">Upload & Import</button>
    <% end %>
  </div>
</div>
