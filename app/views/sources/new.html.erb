<% content_for(:page_title) { "Add Source" } %>

<div class="max-w-3xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Back to Sources", sources_path, class: "text-sm text-stone-500 hover:text-stone-900 transition-colors" %>
  </div>

  <h1 class="text-2xl font-bold font-serif-display text-stone-900 mb-1">Connect a Source</h1>
  <p class="text-stone-500 mb-8">Choose where your customer feedback comes from.</p>

  <!-- OAuth Sources -->
  <div class="mb-10">
    <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider mb-4">Integrations</p>
    <div class="grid grid-cols-2 gap-4">
      <%
        oauth_sources = [
          { provider: "slack", icon: "💬", name: "Slack", desc: "Collect feedback from Slack channels and threads", color: "#4A154B" },
          { provider: "gmail", icon: "✉️", name: "Gmail", desc: "Import feedback from email conversations", color: "#EA4335" },
          { provider: "jira", icon: "⚡", name: "Jira", desc: "Import issues and comments as feedback", color: "#0052CC" },
          { provider: "typeform", icon: "📊", name: "Typeform", desc: "Collect survey responses automatically", color: "#262626" },
        ]
      %>
      <% oauth_sources.each do |src| %>
        <% existing = current_account.sources.find_by(source_type: src[:provider]) %>
        <div class="bg-white rounded-xl border border-stone-200 p-5 hover:shadow-md hover:border-stone-300 transition-all group">
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl flex items-center justify-center text-xl" style="background: <%= src[:color] %>10">
              <%= src[:icon] %>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-stone-900 text-[15px]"><%= src[:name] %></h3>
              <p class="text-xs text-stone-500 mt-0.5 leading-relaxed"><%= src[:desc] %></p>
              <div class="mt-3">
                <% if existing&.active? %>
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 px-3 py-1.5 rounded-full border border-emerald-200">
                    <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span> Connected
                  </span>
                <% else %>
                  <%# Slack/Gmail: POST directly to OmniAuth path (OmniAuth only accepts POST).
                      Jira/Typeform: POST to our controller which redirects to their auth URL.
                      data-turbo="false" is CRITICAL — Turbo fetch cannot follow cross-origin redirects. %>
                  <% if %w[slack gmail].include?(src[:provider]) %>
                    <% omniauth_path = src[:provider] == "slack" ? "/auth/slack_openid" : "/auth/google_oauth2" %>
                    <%= button_to "Connect #{src[:name]}", omniauth_path, method: :post,
                        data: { turbo: false },
                        class: "px-4 py-2 rounded-lg bg-stone-900 text-white text-xs font-semibold hover:bg-stone-800 transition-colors" %>
                  <% else %>
                    <%= button_to "Connect #{src[:name]}", connect_source_path(provider: src[:provider]), method: :post,
                        data: { turbo: false },
                        class: "px-4 py-2 rounded-lg bg-stone-900 text-white text-xs font-semibold hover:bg-stone-800 transition-colors" %>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- App Store -->
  <div class="mb-10">
    <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider mb-4">App Reviews</p>
    <div class="bg-white rounded-xl border border-stone-200 p-5 hover:shadow-md hover:border-stone-300 transition-all">
      <div class="flex items-start gap-4">
        <div class="w-11 h-11 rounded-xl bg-amber-50 flex items-center justify-center text-xl">⭐</div>
        <div class="flex-1">
          <h3 class="font-bold text-stone-900 text-[15px]">App Store Reviews</h3>
          <p class="text-xs text-stone-500 mt-0.5 mb-3">Automatically scrape iOS App Store reviews for your app.</p>
          <%= form_with url: sources_path, method: :post, local: true, class: "flex gap-2" do |f| %>
            <%= hidden_field_tag "source[source_type]", "appstore" %>
            <input type="text" name="source[config][app_id]" placeholder="com.your.app.id"
              class="flex-1 px-3 py-2 border border-stone-300 rounded-lg text-sm focus:ring-2 focus:ring-stone-900/10 focus:border-stone-500 outline-none transition">
            <button type="submit" class="px-4 py-2 rounded-lg bg-stone-900 text-white text-xs font-semibold hover:bg-stone-800 transition-colors">Add</button>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- CSV Import -->
  <div class="mb-6">
    <p class="text-xs font-semibold text-stone-400 uppercase tracking-wider mb-4">Manual Import</p>
    <div class="bg-white rounded-xl border border-stone-200 p-5 hover:shadow-md hover:border-stone-300 transition-all">
      <div class="flex items-start gap-4">
        <div class="w-11 h-11 rounded-xl bg-stone-100 flex items-center justify-center text-xl">📄</div>
        <div class="flex-1">
          <h3 class="font-bold text-stone-900 text-[15px]">CSV Import</h3>
          <p class="text-xs text-stone-500 mt-0.5 mb-3">Upload a CSV file with your feedback data.</p>
          <%= form_with url: import_csv_source_path, method: :post, local: true, multipart: true do %>
            <div class="flex gap-2 items-center">
              <label class="flex-1 flex items-center gap-2 px-3 py-2 border border-stone-300 rounded-lg cursor-pointer hover:bg-stone-50 transition-colors">
                <svg class="w-4 h-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" /></svg>
                <span class="text-sm text-stone-500" id="csv-filename">Choose file...</span>
                <input type="file" name="file" accept=".csv" class="hidden" onchange="document.getElementById('csv-filename').textContent = this.files[0]?.name || 'Choose file...'">
              </label>
              <button type="submit" class="px-4 py-2 rounded-lg bg-stone-900 text-white text-xs font-semibold hover:bg-stone-800 transition-colors">Upload</button>
            </div>
            <p class="text-[11px] text-stone-400 mt-2">Required columns: <code class="bg-stone-100 px-1 rounded">content</code>. Optional: <code class="bg-stone-100 px-1 rounded">author_name</code>, <code class="bg-stone-100 px-1 rounded">author_email</code>, <code class="bg-stone-100 px-1 rounded">received_at</code></p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
