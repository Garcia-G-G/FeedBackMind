<% content_for(:page_title) { "Sources" } %>
<% content_for(:topbar_actions) do %>
  <%= link_to new_source_path, class: "inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-stone-900 text-white hover:bg-stone-800 transition-colors font-medium text-sm" do %>
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
    </svg>
    Add Source
  <% end %>
<% end %>

<div class="space-y-6">
  <% if @sources.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @sources.each do |source| %>
        <div class="bg-white rounded-xl border border-stone-200 p-5 hover:shadow-sm transition-shadow flex flex-col">
          <div class="flex items-start justify-between mb-4">
            <div class="text-3xl">
              <%= source_emoji(source.source_type) %>
            </div>
            <div class="flex items-center gap-1">
              <span class="<%= source.active? ? 'bg-emerald-500' : 'bg-stone-300' %> h-2.5 w-2.5 rounded-full"></span>
              <span class="text-xs font-medium text-stone-600">
                <%= source.active? ? 'Active' : 'Inactive' %>
              </span>
            </div>
          </div>

          <h3 class="text-base font-semibold text-stone-900 mb-1">
            <%= source.source_type.titleize %>
          </h3>

          <div class="border-t border-stone-200 pt-4 mt-auto">
            <div class="flex items-center justify-between mb-4">
              <div>
                <p class="text-2xl font-bold text-stone-900">
                  <%= source.feedbacks.count %>
                </p>
                <p class="text-xs text-stone-600">Feedbacks</p>
              </div>
              <div class="text-right">
                <p class="text-xs text-stone-600">
                  Last sync
                </p>
                <p class="text-xs font-medium text-stone-700">
                  <% if source.last_synced_at.present? %>
                    <%= format_time_ago(source.last_synced_at) %>
                  <% else %>
                    Never
                  <% end %>
                </p>
              </div>
            </div>

            <div class="flex items-center justify-between">
              <%= link_to source_path(source), class: "inline-flex items-center gap-1 text-sm text-stone-900 hover:text-stone-700 font-medium" do %>
                View Details →
              <% end %>
              <% if source.active? && source.config&.dig("access_token").present? %>
                <%= button_to sync_source_path(source), method: :post, data: { turbo: false }, class: "text-xs px-3 py-1.5 rounded-lg border border-stone-300 text-stone-600 hover:bg-stone-100 transition-colors" do %>
                  Sync Now
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl border border-stone-200 p-12 text-center">
      <div class="mb-4">
        <svg class="mx-auto h-12 w-12 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.658 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-stone-900 mb-2">No sources connected</h3>
      <p class="text-sm text-stone-600 mb-6">Connect your first feedback source to start collecting customer insights.</p>
      <%= link_to "Add Source", new_source_path, class: "inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-stone-900 text-white hover:bg-stone-800 transition-colors font-medium" %>
    </div>
  <% end %>
</div>
