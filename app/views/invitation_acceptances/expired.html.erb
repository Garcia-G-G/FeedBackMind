<div class="min-h-screen bg-stone-50 flex items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <div class="flex justify-center mb-4">
        <div class="h-12 w-12 bg-stone-900 rounded-lg flex items-center justify-center">
          <svg class="h-7 w-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>
      <h1 class="text-2xl font-bold font-serif-display text-stone-900">Invitation Expired</h1>
    </div>

    <div class="bg-white rounded-xl border border-stone-200 shadow-sm p-8 text-center">
      <% if @error.present? %>
        <p class="text-sm text-stone-600 mb-6"><%= @error %></p>
      <% else %>
        <p class="text-sm text-stone-600 mb-6">
          This invitation has expired. Please ask your team admin to send a new one.
        </p>
      <% end %>
      <%= link_to "Go to Sign In", new_user_session_path,
          class: "inline-block px-6 py-2.5 rounded-lg bg-stone-900 text-white font-semibold hover:bg-stone-800 transition-colors text-sm" %>
    </div>
  </div>
</div>
