<% content_for(:title) { @feature_request.title } %>

<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <%= link_to portal_path(portal_subdomain: @account.subdomain), class: "text-sm text-stone-900 hover:text-stone-700 font-medium" do %>
      &larr; Back to requests
    <% end %>
  </div>

  <div class="bg-white rounded-xl border border-stone-200 p-6">
    <div class="flex gap-4">
      <!-- Vote Button -->
      <div id="vote-button-<%= @feature_request.id %>" class="shrink-0">
        <%= render "portal/vote_button", feature_request: @feature_request, voter_email: @voter_email, account: @account %>
      </div>

      <!-- Content -->
      <div class="flex-1 min-w-0">
        <div class="flex items-start justify-between gap-3 mb-3">
          <h1 class="text-xl font-bold text-stone-900 font-serif-display"><%= @feature_request.title %></h1>
          <span class="shrink-0 text-xs px-2.5 py-1 rounded-full font-medium <%= @feature_request.status_color_class %>">
            <%= @feature_request.status.titleize %>
          </span>
        </div>

        <% if @feature_request.description.present? %>
          <div class="text-sm text-stone-700 leading-relaxed mb-4 whitespace-pre-wrap"><%= @feature_request.description %></div>
        <% end %>

        <!-- Metadata -->
        <div class="border-t border-stone-200 pt-4 mt-4">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
            <div>
              <p class="text-xs font-semibold text-stone-500 uppercase tracking-wide mb-0.5">Author</p>
              <p class="text-stone-700"><%= @feature_request.author_name.presence || "Anonymous" %></p>
            </div>
            <div>
              <p class="text-xs font-semibold text-stone-500 uppercase tracking-wide mb-0.5">Submitted</p>
              <p class="text-stone-700"><%= format_time_ago(@feature_request.created_at) %></p>
            </div>
            <div>
              <p class="text-xs font-semibold text-stone-500 uppercase tracking-wide mb-0.5">Votes</p>
              <p class="text-stone-700 font-bold"><%= @feature_request.votes_count %></p>
            </div>
            <% if @feature_request.category.present? %>
              <div>
                <p class="text-xs font-semibold text-stone-500 uppercase tracking-wide mb-0.5">Category</p>
                <p class="text-stone-700"><%= @feature_request.category %></p>
              </div>
            <% end %>
          </div>

          <% if @feature_request.status_shipped? && @feature_request.shipped_at.present? %>
            <div class="mt-4 px-4 py-3 rounded-lg bg-emerald-50 border border-emerald-200 text-sm text-emerald-800">
              Shipped on <%= @feature_request.shipped_at.strftime("%B %d, %Y") %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
