<% content_for(:title) { "What's New" } %>

<div class="space-y-6">
  <div class="text-center mb-8">
    <h1 class="text-2xl font-bold text-stone-900 font-serif-display mb-2">What's New</h1>
    <p class="text-sm text-stone-500">Latest product updates and improvements</p>
  </div>

  <!-- Category Filter -->
  <div class="flex justify-center flex-wrap gap-2 mb-8">
    <%= link_to portal_changelog_path(portal_subdomain: @account.subdomain),
        class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{params[:category].blank? ? 'bg-stone-900 text-white' : 'bg-white text-stone-600 border border-stone-300 hover:bg-stone-50'}" do %>
      All
    <% end %>
    <% [["new_feature", "🚀 Features"], ["improvement", "✨ Improvements"], ["fix", "🐛 Fixes"], ["announcement", "📢 News"]].each do |key, label| %>
      <%= link_to portal_changelog_path(portal_subdomain: @account.subdomain, category: key),
          class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{params[:category] == key ? 'bg-stone-900 text-white' : 'bg-white text-stone-600 border border-stone-300 hover:bg-stone-50'}" do %>
        <%= label %>
      <% end %>
    <% end %>
  </div>

  <!-- Timeline -->
  <% if @entries.any? %>
    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-[19px] top-2 bottom-2 w-px bg-stone-200"></div>

      <div class="space-y-8">
        <% @entries.each do |entry| %>
          <div class="relative flex gap-5">
            <!-- Dot -->
            <div class="shrink-0 w-10 flex justify-center pt-1.5">
              <div class="w-2.5 h-2.5 rounded-full bg-stone-900 ring-4 ring-stone-50 z-10"></div>
            </div>

            <!-- Content -->
            <div class="flex-1 pb-2">
              <p class="text-xs text-stone-400 mb-2"><%= entry.formatted_date %></p>
              <div class="bg-white rounded-xl border border-stone-200 p-5">
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-xs px-2 py-0.5 rounded-full font-medium <%= entry.category_color_class %>"><%= entry.category_emoji %> <%= entry.category_label %></span>
                  <% if entry.version.present? %>
                    <span class="text-xs font-mono text-stone-500"><%= entry.version %></span>
                  <% end %>
                </div>
                <h2 class="text-base font-semibold text-stone-900 mb-2"><%= entry.title %></h2>
                <div class="text-sm text-stone-600 leading-relaxed">
                  <%= simple_format(entry.body) %>
                </div>

                <% if entry.feature_requests.any? %>
                  <div class="mt-4 pt-3 border-t border-stone-200">
                    <p class="text-xs text-stone-400 mb-2">Related feature requests:</p>
                    <div class="flex flex-wrap gap-2">
                      <% entry.feature_requests.each do |fr| %>
                        <%= link_to portal_request_path(portal_subdomain: @account.subdomain, slug: fr.slug),
                            class: "inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-stone-100 text-xs font-medium text-stone-600 hover:bg-stone-200 transition-colors" do %>
                          <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7" /></svg>
                          <%= fr.votes_count %> &middot; <%= fr.title.truncate(40) %>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="bg-white rounded-xl border border-stone-200 p-12 text-center">
      <svg class="mx-auto h-12 w-12 text-stone-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
      <h3 class="text-lg font-semibold text-stone-900 mb-2">No updates yet</h3>
      <p class="text-sm text-stone-500">Check back soon for product updates!</p>
    </div>
  <% end %>
</div>
