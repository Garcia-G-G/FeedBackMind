<% voted = voter_email.present? && feature_request.voted_by?(voter_email) %>

<% if voter_email.present? %>
  <%= form_with url: portal_vote_path(portal_subdomain: account.subdomain, slug: feature_request.slug),
      method: :post, data: { turbo: true } do %>
    <button type="submit"
      class="flex flex-col items-center justify-center w-14 h-16 rounded-xl border-2 transition-colors
             <%= voted ? 'bg-stone-900 border-stone-900 text-white' : 'bg-white border-stone-200 text-stone-500 hover:border-stone-400' %>">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7" />
      </svg>
      <span class="text-sm font-bold"><%= feature_request.votes_count %></span>
    </button>
  <% end %>
<% else %>
  <div class="relative">
    <details class="group">
      <summary class="list-none cursor-pointer">
        <div class="flex flex-col items-center justify-center w-14 h-16 rounded-xl border-2 bg-white border-stone-200 text-stone-500 hover:border-stone-400 transition-colors">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7" />
          </svg>
          <span class="text-sm font-bold"><%= feature_request.votes_count %></span>
        </div>
      </summary>
      <div class="absolute mt-2 z-10 bg-white rounded-xl border border-stone-200 shadow-lg p-4 w-64">
        <%= form_with url: portal_vote_path(portal_subdomain: account.subdomain, slug: feature_request.slug),
            method: :post, data: { turbo: false } do %>
          <p class="text-xs text-stone-500 mb-2">Enter your email to vote</p>
          <input type="email" name="voter_email" required placeholder="you@example.com"
            class="w-full px-3 py-2 rounded-lg border border-stone-300 text-sm mb-2 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent">
          <button type="submit"
            class="w-full px-3 py-2 rounded-lg bg-stone-900 text-white text-sm font-semibold hover:bg-stone-800 transition-colors">
            Vote
          </button>
        <% end %>
      </div>
    </details>
  </div>
<% end %>
