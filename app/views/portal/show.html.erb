<div class="space-y-6">
  <!-- Search & Sort -->
  <div class="flex flex-col sm:flex-row gap-3">
    <form action="<%= portal_path(portal_subdomain: @account.subdomain) %>" method="get" class="flex-1" data-turbo="false">
      <!-- Preserve current filters -->
      <% if params[:status].present? %>
        <input type="hidden" name="status" value="<%= params[:status] %>">
      <% end %>
      <% if params[:category].present? %>
        <input type="hidden" name="category" value="<%= params[:category] %>">
      <% end %>
      <% if params[:sort].present? %>
        <input type="hidden" name="sort" value="<%= params[:sort] %>">
      <% end %>
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input type="text" name="q" value="<%= params[:q] %>" placeholder="Search feature requests..."
          class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-stone-300 bg-white text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent">
      </div>
    </form>
    <div class="flex gap-2">
      <%= link_to portal_path(portal_subdomain: @account.subdomain, q: params[:q], status: params[:status], category: params[:category]),
          class: "px-3 py-2.5 rounded-lg border text-sm font-medium transition-colors #{params[:sort] != 'recent' ? 'bg-stone-900 text-white border-stone-900' : 'bg-white text-stone-600 border-stone-300 hover:bg-stone-50'}" do %>
        Most Voted
      <% end %>
      <%= link_to portal_path(portal_subdomain: @account.subdomain, sort: "recent", q: params[:q], status: params[:status], category: params[:category]),
          class: "px-3 py-2.5 rounded-lg border text-sm font-medium transition-colors #{params[:sort] == 'recent' ? 'bg-stone-900 text-white border-stone-900' : 'bg-white text-stone-600 border-stone-300 hover:bg-stone-50'}" do %>
        Newest
      <% end %>
    </div>
  </div>

  <!-- Status Tabs -->
  <div class="flex flex-wrap gap-2">
    <% total = @status_counts.values.sum %>
    <%= link_to portal_path(portal_subdomain: @account.subdomain, q: params[:q], sort: params[:sort], category: params[:category]),
        class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{params[:status].blank? ? 'bg-stone-900 text-white' : 'bg-white text-stone-600 border border-stone-300 hover:bg-stone-50'}" do %>
      All <span class="ml-1 opacity-70"><%= total %></span>
    <% end %>
    <% %w[open planned in_progress shipped].each do |status| %>
      <% count = @status_counts[status] || 0 %>
      <%= link_to portal_path(portal_subdomain: @account.subdomain, status: status, q: params[:q], sort: params[:sort], category: params[:category]),
          class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{params[:status] == status ? 'bg-stone-900 text-white' : 'bg-white text-stone-600 border border-stone-300 hover:bg-stone-50'}" do %>
        <%= status.titleize %> <span class="ml-1 opacity-70"><%= count %></span>
      <% end %>
    <% end %>
  </div>

  <!-- Active Category Filter -->
  <% if params[:category].present? %>
    <div class="flex items-center gap-2">
      <span class="text-sm text-stone-500">Category:</span>
      <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-stone-100 text-sm font-medium text-stone-700">
        <%= params[:category] %>
        <%= link_to portal_path(portal_subdomain: @account.subdomain, q: params[:q], sort: params[:sort], status: params[:status]), class: "ml-1 text-stone-400 hover:text-stone-600" do %>
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        <% end %>
      </span>
    </div>
  <% end %>

  <!-- Feature Request Cards -->
  <% if @feature_requests.any? %>
    <div class="space-y-3">
      <% @feature_requests.each do |fr| %>
        <div class="bg-white rounded-xl border border-stone-200 p-5 hover:shadow-sm transition-shadow">
          <div class="flex gap-4">
            <!-- Vote Button -->
            <div id="vote-button-<%= fr.id %>">
              <%= render "portal/vote_button", feature_request: fr, voter_email: @voter_email, account: @account %>
            </div>

            <!-- Content -->
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-3 mb-1">
                <%= link_to portal_request_path(portal_subdomain: @account.subdomain, slug: fr.slug),
                    class: "text-base font-semibold text-stone-900 hover:text-stone-700 line-clamp-1" do %>
                  <%= fr.title %>
                <% end %>
                <span class="shrink-0 text-xs px-2.5 py-1 rounded-full font-medium <%= fr.status_color_class %>">
                  <%= fr.status.titleize %>
                </span>
              </div>
              <% if fr.description.present? %>
                <p class="text-sm text-stone-600 line-clamp-2 mb-2"><%= fr.description %></p>
              <% end %>
              <div class="flex items-center gap-3 text-xs text-stone-400">
                <span><%= fr.author_name.presence || "Anonymous" %></span>
                <span><%= format_time_ago(fr.created_at) %></span>
                <% if fr.category.present? %>
                  <%= link_to portal_path(portal_subdomain: @account.subdomain, category: fr.category, q: params[:q], sort: params[:sort], status: params[:status]),
                      class: "px-2 py-0.5 rounded-full bg-stone-100 text-stone-500 hover:bg-stone-200 transition-colors" do %>
                    <%= fr.category %>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl border border-stone-200 p-12 text-center">
      <svg class="mx-auto h-12 w-12 text-stone-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
      </svg>
      <h3 class="text-lg font-semibold text-stone-900 mb-2">No feature requests yet</h3>
      <p class="text-sm text-stone-500 mb-6">Be the first to suggest an idea!</p>
      <%= link_to "Submit Request", portal_new_request_path(portal_subdomain: @account.subdomain),
          class: "inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-stone-900 text-white hover:bg-stone-800 transition-colors font-medium text-sm" %>
    </div>
  <% end %>
</div>
