<% content_for(:page_title) { "Feedbacks" } %>

<div class="min-h-screen bg-gray-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <!-- Page Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Feedbacks</h1>
      <p class="mt-2 text-sm text-gray-500">Manage and review all customer feedback</p>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white border border-gray-100 rounded-xl p-4 mb-6">
      <div class="flex flex-wrap gap-3 items-center">
        <!-- Sentiment Filter -->
        <div class="flex-shrink-0">
          <label for="sentiment-filter" class="sr-only">Sentiment</label>
          <select id="sentiment-filter" name="sentiment" class="border border-gray-200 rounded-lg text-[13px] px-3 py-2 text-gray-700 bg-white hover:border-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
            <option value="">All Sentiments</option>
            <option value="positive">Positive</option>
            <option value="neutral">Neutral</option>
            <option value="negative">Negative</option>
          </select>
        </div>

        <!-- Source Type Filter -->
        <div class="flex-shrink-0">
          <label for="source-filter" class="sr-only">Source</label>
          <select id="source-filter" name="source_type" class="border border-gray-200 rounded-lg text-[13px] px-3 py-2 text-gray-700 bg-white hover:border-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
            <option value="">All Sources</option>
            <option value="slack">Slack</option>
            <option value="email">Email</option>
            <option value="twitter">Twitter</option>
            <option value="zendesk">Zendesk</option>
            <option value="feature_request">Feature Request</option>
            <option value="intercom">Intercom</option>
          </select>
        </div>

        <!-- Topic/Search Filter -->
        <div class="flex-shrink-0 flex-1 min-w-[200px]">
          <label for="topic-filter" class="sr-only">Search topics</label>
          <input type="text" id="topic-filter" name="topic" placeholder="Search topics..." class="w-full border border-gray-200 rounded-lg text-[13px] px-3 py-2 text-gray-700 bg-white placeholder-gray-400 hover:border-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
        </div>

        <!-- Clear Filters -->
        <div class="flex-shrink-0">
          <%= link_to "Clear filters", feedbacks_path, class: "text-indigo-600 hover:text-indigo-700 text-sm font-medium" %>
        </div>
      </div>
    </div>

    <!-- Feedbacks List Card -->
    <div class="bg-white border border-gray-100 rounded-xl overflow-hidden">
      <div class="divide-y divide-gray-100">
        <% if @feedbacks.present? %>
          <% @feedbacks.each do |feedback| %>
            <div class="p-5 hover:bg-gray-50 transition-colors">
              <div class="flex gap-3">
                <!-- Sentiment Indicator -->
                <% sentiment_colors = {
                  "positive" => "bg-emerald-500",
                  "neutral" => "bg-gray-300",
                  "negative" => "bg-red-400"
                } %>
                <div class="w-3 h-3 rounded-full flex-shrink-0 mt-1.5 <%= sentiment_colors[feedback.sentiment] || 'bg-gray-300' %>"></div>

                <!-- Content -->
                <div class="flex-1 min-w-0">
                  <p class="text-[14px] text-gray-900 leading-relaxed"><%= feedback.content %></p>

                  <!-- Topics Tags -->
                  <% if feedback.topics.present? %>
                    <div class="flex flex-wrap gap-2 mt-3">
                      <% feedback.topics.each do |topic| %>
                        <span class="text-[11px] bg-indigo-50 border border-indigo-200 text-indigo-700 font-medium px-2 py-1 rounded-full">
                          <%= topic %>
                        </span>
                      <% end %>
                    </div>
                  <% end %>

                  <!-- Meta Information -->
                  <div class="flex items-center gap-4 mt-3 text-[12px] text-gray-500">
                    <span>
                      <strong class="text-gray-700"><%= feedback.source&.source_type&.capitalize || "Unknown" %></strong>
                    </span>
                    <span><%= time_ago_in_words(feedback.created_at) %> ago</span>
                    <% if feedback.respond_to?(:user) && feedback.user.present? %>
                      <span>By <strong class="text-gray-700"><%= feedback.user.name %></strong></span>
                    <% end %>
                  </div>
                </div>

                <!-- Actions -->
                <div class="flex-shrink-0 ml-4">
                  <%= link_to "View", feedback_path(feedback), class: "text-indigo-600 hover:text-indigo-700 text-sm font-medium" %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="px-5 py-12 text-center">
            <p class="text-gray-500">No feedbacks found. Try adjusting your filters.</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Pagination -->
    <% if @feedbacks.respond_to?(:current_page) && (@feedbacks.current_page > 1 || @feedbacks.next_page) %>
      <div class="mt-6 flex items-center justify-between">
        <div class="text-sm text-gray-500">
          Page <span class="font-medium"><%= @feedbacks.current_page %></span> of <span class="font-medium"><%= @feedbacks.total_pages %></span>
        </div>
        <div class="flex gap-3">
          <% if @feedbacks.current_page > 1 %>
            <%= link_to "← Previous", feedbacks_path(page: @feedbacks.current_page - 1), class: "px-4 py-2 border border-gray-200 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors" %>
          <% end %>
          <% if @feedbacks.next_page %>
            <%= link_to "Next →", feedbacks_path(page: @feedbacks.next_page), class: "px-4 py-2 border border-gray-200 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
