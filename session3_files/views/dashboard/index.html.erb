<% content_for(:page_title) { "Dashboard" } %>

<div class="min-h-screen bg-gray-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <!-- Page Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Dashboard</h1>
      <p class="mt-2 text-sm text-gray-500">Monitor feedback insights and sentiment across your sources</p>
    </div>

    <!-- 4 Metric Cards Grid -->
    <div class="grid grid-cols-4 gap-3.5 mb-6">
      <!-- Total Feedbacks Card -->
      <div class="bg-white border border-gray-100 rounded-xl p-5 hover:shadow-sm transition-shadow">
        <p class="text-xs text-gray-400 font-medium mb-3">Total Feedbacks</p>
        <div class="flex items-end justify-between">
          <div class="text-3xl font-extrabold tracking-tight text-gray-900">
            <%= @feedbacks_count || 1284 %>
          </div>
          <div class="bg-emerald-50 text-emerald-700 text-[11px] font-semibold px-2 py-1 rounded-full">
            +12%
          </div>
        </div>
      </div>

      <!-- Sentiment Score Card -->
      <div class="bg-white border border-gray-100 rounded-xl p-5 hover:shadow-sm transition-shadow">
        <p class="text-xs text-gray-400 font-medium mb-3">Sentiment Score</p>
        <div class="flex items-end justify-between">
          <div class="text-3xl font-extrabold tracking-tight text-emerald-600">
            <%= @sentiment_score || 72 %>%
          </div>
          <div class="bg-emerald-50 text-emerald-700 text-[11px] font-semibold px-2 py-1 rounded-full">
            +5%
          </div>
        </div>
      </div>

      <!-- Active Sources Card -->
      <div class="bg-white border border-gray-100 rounded-xl p-5 hover:shadow-sm transition-shadow">
        <p class="text-xs text-gray-400 font-medium mb-3">Active Sources</p>
        <div class="flex items-end justify-between">
          <div class="text-3xl font-extrabold tracking-tight text-gray-900">
            <%= @active_sources_count || 6 %>/<%= @total_sources_count || 8 %>
          </div>
          <div class="bg-emerald-50 text-emerald-700 text-[11px] font-semibold px-2 py-1 rounded-full">
            +1
          </div>
        </div>
      </div>

      <!-- AI Impact Score Card -->
      <div class="bg-white border border-gray-100 rounded-xl p-5 border-l-[3px] border-l-indigo-500 hover:shadow-sm transition-shadow">
        <p class="text-xs text-gray-400 font-medium mb-3">AI Impact Score</p>
        <div class="mb-4">
          <div class="text-3xl font-extrabold tracking-tight text-gray-900">8.4</div>
        </div>
        <div>
          <p class="text-[11px] text-gray-500 font-medium mb-2">Churn Risk</p>
          <div class="w-full bg-gray-100 rounded-full h-1.5 overflow-hidden">
            <div class="bg-red-500 h-full rounded-full" style="width: 78%"></div>
          </div>
          <p class="text-[10px] text-red-600 font-medium mt-1">78% - High Risk</p>
        </div>
      </div>
    </div>

    <!-- Sentiment Timeline -->
    <div class="bg-white border border-gray-100 rounded-xl p-5 mb-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-sm font-bold text-gray-900">Sentiment Timeline</h2>
        <div class="flex gap-3">
          <div class="flex items-center gap-2">
            <div class="w-2.5 h-2.5 bg-emerald-500 rounded-full"></div>
            <span class="text-[12px] text-gray-500">Positive</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2.5 h-2.5 bg-gray-300 rounded-full"></div>
            <span class="text-[12px] text-gray-500">Neutral</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2.5 h-2.5 bg-red-400 rounded-full"></div>
            <span class="text-[12px] text-gray-500">Negative</span>
          </div>
        </div>
      </div>

      <!-- 7-Day Sentiment Bars -->
      <div class="flex items-flex-end justify-between gap-2 h-40">
        <% ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].each_with_index do |day, idx| %>
          <% percentages = [
            { pos: 65, neu: 20, neg: 15 },
            { pos: 72, neu: 18, neg: 10 },
            { pos: 58, neu: 22, neg: 20 },
            { pos: 78, neu: 15, neg: 7 },
            { pos: 81, neu: 12, neg: 7 },
            { pos: 68, neu: 20, neg: 12 },
            { pos: 75, neu: 16, neg: 9 }
          ][idx] %>

          <div class="flex-1 flex flex-col gap-1">
            <div class="w-full flex flex-col items-stretch gap-px h-32">
              <div class="bg-emerald-500 rounded-t-sm flex-grow" style="flex-basis: <%= percentages[:pos] %>%"></div>
              <div class="bg-gray-300 flex-grow" style="flex-basis: <%= percentages[:neu] %>%"></div>
              <div class="bg-red-400 rounded-b-sm flex-grow" style="flex-basis: <%= percentages[:neg] %>%"></div>
            </div>
            <span class="text-[11px] text-gray-500 text-center font-medium"><%= day %></span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Two-Column Layout: Weekly Themes + Sentiment Breakdown + Sources -->
    <div class="grid grid-cols-[1fr_380px] gap-5 mb-6">
      <!-- Weekly Themes Card -->
      <div class="bg-white border border-gray-100 rounded-xl overflow-hidden">
        <div class="border-b border-gray-100 px-5 py-4 flex items-center justify-between bg-gray-50">
          <h2 class="text-sm font-bold text-gray-900">Weekly Themes</h2>
          <div class="flex items-center gap-2">
            <span class="bg-indigo-500 text-white text-[9px] font-bold px-1.5 py-0.5 rounded">AI</span>
            <%= link_to "View synthesis", "#", class: "text-indigo-600 hover:text-indigo-700 text-xs font-medium" %>
          </div>
        </div>

        <div class="divide-y divide-gray-100">
          <% themes = @weekly_themes&.themes || [
            OpenStruct.new(
              title: "Authentication Issues",
              urgency: "critical",
              description: "Users experiencing login failures with SSO integration",
              feedback_count: 24,
              sources: ["slack", "email"],
              quote: "\"We're losing users daily due to login problems\""
            ),
            OpenStruct.new(
              title: "Dashboard Performance",
              urgency: "high",
              description: "Slow load times on dashboard with large datasets",
              feedback_count: 18,
              sources: ["twitter", "zendesk"],
              quote: "\"The dashboard takes 5+ seconds to load\""
            ),
            OpenStruct.new(
              title: "Export Feature Request",
              urgency: "medium",
              description: "Users requesting CSV/PDF export functionality",
              feedback_count: 12,
              sources: ["feature_request"],
              quote: "\"Would love to export reports to share with team\""
            )
          ] %>

          <% themes.each do |theme| %>
            <div class="p-4">
              <div class="flex items-start justify-between mb-2">
                <h3 class="text-sm font-semibold text-gray-900"><%= theme.title %></h3>
                <% urgency_colors = {
                  "critical" => "bg-red-50 text-red-700",
                  "high" => "bg-amber-50 text-amber-700",
                  "medium" => "bg-blue-50 text-blue-700",
                  "positive" => "bg-emerald-50 text-emerald-700"
                } %>
                <span class="text-[10px] uppercase font-semibold rounded-full px-2 py-0.5 <%= urgency_colors[theme.urgency] || 'bg-gray-50 text-gray-700' %>">
                  <%= theme.urgency %>
                </span>
              </div>
              <p class="text-[13px] text-gray-500 mb-3"><%= theme.description %></p>

              <!-- MRR at Risk Bar -->
              <div class="bg-gray-50 rounded-md p-2.5 mb-3">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-[11px] font-medium text-gray-600">Impact</span>
                  <span class="text-[11px] font-bold text-red-600">$12.4K</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-1 overflow-hidden">
                  <div class="bg-red-500 h-full rounded-full" style="width: 68%"></div>
                </div>
              </div>

              <!-- Quote -->
              <blockquote class="text-[12px] italic text-gray-600 border-l-[3px] border-gray-200 bg-gray-50 rounded-md pl-3 py-2 mb-3">
                <%= theme.quote %>
              </blockquote>

              <!-- Footer -->
              <div class="flex items-center justify-between text-[11px] text-gray-500">
                <span><strong><%= theme.feedback_count %></strong> feedbacks</span>
                <span><%= theme.sources.join(", ") %></span>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Right Column: Sentiment Breakdown + Sources -->
      <div class="flex flex-col gap-5">
        <!-- Sentiment Breakdown -->
        <div class="bg-white border border-gray-100 rounded-xl p-5">
          <h3 class="text-sm font-bold text-gray-900 mb-4">Sentiment Breakdown</h3>

          <!-- Donut Chart (SVG) -->
          <div class="flex justify-center mb-6">
            <svg viewBox="0 0 100 100" class="w-32 h-32">
              <!-- Positive Arc (Emerald) -->
              <circle cx="50" cy="50" r="40" fill="none" stroke="#10b981" stroke-width="8" stroke-dasharray="157 251" stroke-dashoffset="0" transform="rotate(-90 50 50)"></circle>
              <!-- Neutral Arc (Gray) -->
              <circle cx="50" cy="50" r="40" fill="none" stroke="#d1d5db" stroke-width="8" stroke-dasharray="63 251" stroke-dashoffset="-157" transform="rotate(-90 50 50)"></circle>
              <!-- Negative Arc (Red) -->
              <circle cx="50" cy="50" r="40" fill="none" stroke="#f87171" stroke-width="8" stroke-dasharray="31 251" stroke-dashoffset="-220" transform="rotate(-90 50 50)"></circle>
              <!-- Center text -->
              <text x="50" y="50" text-anchor="middle" dy="0.3em" class="text-xs font-bold fill-gray-900">
                <%= @sentiment_score || 72 %>%
              </text>
            </svg>
          </div>

          <!-- Legend -->
          <% sentiment_data = @sentiment_data || { positive: 45, neutral: 20, negative: 10 } %>
          <div class="space-y-2">
            <div class="flex items-center justify-between text-[12px]">
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 bg-emerald-500 rounded-full"></div>
                <span class="text-gray-600">Positive</span>
              </div>
              <div class="flex items-center gap-1">
                <div class="w-20 h-1 bg-gray-100 rounded-full overflow-hidden">
                  <div class="bg-emerald-500 h-full" style="width: 63%"></div>
                </div>
                <span class="font-semibold text-gray-900 w-8">63%</span>
              </div>
            </div>
            <div class="flex items-center justify-between text-[12px]">
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 bg-gray-300 rounded-full"></div>
                <span class="text-gray-600">Neutral</span>
              </div>
              <div class="flex items-center gap-1">
                <div class="w-20 h-1 bg-gray-100 rounded-full overflow-hidden">
                  <div class="bg-gray-300 h-full" style="width: 25%"></div>
                </div>
                <span class="font-semibold text-gray-900 w-8">25%</span>
              </div>
            </div>
            <div class="flex items-center justify-between text-[12px]">
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 bg-red-400 rounded-full"></div>
                <span class="text-gray-600">Negative</span>
              </div>
              <div class="flex items-center gap-1">
                <div class="w-20 h-1 bg-gray-100 rounded-full overflow-hidden">
                  <div class="bg-red-400 h-full" style="width: 12%"></div>
                </div>
                <span class="font-semibold text-gray-900 w-8">12%</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Sources Grid -->
        <div class="bg-white border border-gray-100 rounded-xl p-5">
          <h3 class="text-sm font-bold text-gray-900 mb-4">Sources</h3>
          <div class="grid grid-cols-3 gap-3">
            <% sources = [
              { emoji: "💬", name: "Slack", active: true },
              { emoji: "✉️", name: "Email", active: true },
              { emoji: "🐦", name: "Twitter", active: true },
              { emoji: "📝", name: "Zendesk", active: false },
              { emoji: "💡", name: "Feature Req", active: true },
              { emoji: "🎯", name: "Intercom", active: false }
            ] %>

            <% sources.each do |source| %>
              <div class="text-center">
                <div class="flex items-center justify-center mb-2">
                  <div class="text-2xl"><%= source[:emoji] %></div>
                </div>
                <p class="text-[12px] font-medium text-gray-900 mb-1"><%= source[:name] %></p>
                <div class="flex justify-center">
                  <div class="w-2 h-2 rounded-full <%= source[:active] ? 'bg-emerald-500' : 'bg-gray-300' %>"></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Feedback Pipeline (Kanban) -->
    <div class="bg-white border border-gray-100 rounded-xl p-5 mb-6">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-sm font-bold text-gray-900">Feedback Pipeline</h2>
        <span class="bg-blue-100 text-blue-700 text-[11px] font-bold px-2 py-1 rounded-full">NEW</span>
      </div>

      <div class="grid grid-cols-4 gap-5">
        <!-- Raw Feedback Column -->
        <div class="border-l-[3px] border-gray-400 pl-4">
          <div class="flex items-center gap-2 mb-4">
            <h3 class="text-xs font-bold text-gray-900">Raw Feedback</h3>
            <span class="bg-gray-100 text-gray-700 text-[10px] font-bold px-1.5 py-0.5 rounded-full">8</span>
          </div>
          <div class="space-y-2">
            <% 2.times do |i| %>
              <div class="bg-gray-50 rounded-lg p-3 border border-gray-100">
                <h4 class="text-xs font-semibold text-gray-900 line-clamp-1">User reported slow loading</h4>
                <p class="text-[10px] text-gray-400 mt-1">2 hours ago • Slack</p>
                <span class="inline-block bg-indigo-50 text-indigo-700 text-[9px] font-medium px-1.5 py-0.5 rounded mt-2">Performance</span>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Insights Column -->
        <div class="border-l-[3px] border-indigo-500 pl-4">
          <div class="flex items-center gap-2 mb-4">
            <h3 class="text-xs font-bold text-gray-900">Insights</h3>
            <span class="bg-indigo-100 text-indigo-700 text-[10px] font-bold px-1.5 py-0.5 rounded-full">5</span>
          </div>
          <div class="space-y-2">
            <% 2.times do |i| %>
              <div class="bg-gray-50 rounded-lg p-3 border border-gray-100">
                <h4 class="text-xs font-semibold text-gray-900 line-clamp-1">Dashboard perf issue identified</h4>
                <p class="text-[10px] text-gray-400 mt-1">Affects 15% of users</p>
                <span class="inline-block bg-amber-50 text-amber-700 text-[9px] font-medium px-1.5 py-0.5 rounded mt-2">Analysis</span>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Action Items Column -->
        <div class="border-l-[3px] border-amber-500 pl-4">
          <div class="flex items-center gap-2 mb-4">
            <h3 class="text-xs font-bold text-gray-900">Action Items</h3>
            <span class="bg-amber-100 text-amber-700 text-[10px] font-bold px-1.5 py-0.5 rounded-full">3</span>
          </div>
          <div class="space-y-2">
            <% 2.times do |i| %>
              <div class="bg-gray-50 rounded-lg p-3 border border-gray-100">
                <h4 class="text-xs font-semibold text-gray-900 line-clamp-1">Optimize database queries</h4>
                <p class="text-[10px] text-gray-400 mt-1">Assigned • Est. 2 days</p>
                <span class="inline-block bg-blue-50 text-blue-700 text-[9px] font-medium px-1.5 py-0.5 rounded mt-2">Engineering</span>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Shipped Column -->
        <div class="border-l-[3px] border-emerald-500 pl-4">
          <div class="flex items-center gap-2 mb-4">
            <h3 class="text-xs font-bold text-gray-900">Shipped</h3>
            <span class="bg-emerald-100 text-emerald-700 text-[10px] font-bold px-1.5 py-0.5 rounded-full">12</span>
          </div>
          <div class="space-y-2">
            <% 2.times do |i| %>
              <div class="bg-gray-50 rounded-lg p-3 border border-gray-100">
                <h4 class="text-xs font-semibold text-gray-900 line-clamp-1">Faster export feature</h4>
                <p class="text-[10px] text-gray-400 mt-1">v2.4.0 • Last week</p>
                <span class="inline-block bg-emerald-50 text-emerald-700 text-[9px] font-medium px-1.5 py-0.5 rounded mt-2">Released</span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Two-Column: Recent Feedbacks + Closed-Loop Tracker -->
    <div class="grid grid-cols-2 gap-5">
      <!-- Recent Feedbacks -->
      <div class="bg-white border border-gray-100 rounded-xl p-5">
        <h2 class="text-sm font-bold text-gray-900 mb-4">Recent Feedbacks</h2>
        <div class="space-y-3">
          <% (@recent_feedbacks || []).first(5).each do |feedback| %>
            <div class="flex gap-2.5 pb-3 border-b border-gray-100 last:border-0 last:pb-0">
              <% sentiment_colors = {
                "positive" => "bg-emerald-500",
                "neutral" => "bg-gray-300",
                "negative" => "bg-red-400"
              } %>
              <div class="w-2 h-2 rounded-full flex-shrink-0 mt-1 <%= sentiment_colors[feedback.sentiment] || 'bg-gray-300' %>"></div>
              <div class="flex-1 min-w-0">
                <p class="text-[13px] text-gray-700 line-clamp-2"><%= feedback.content %></p>
                <div class="flex items-center gap-2 mt-2">
                  <% (feedback.topics || []).first(2).each do |topic| %>
                    <span class="text-[10px] bg-gray-50 border border-gray-200 text-gray-600 px-1.5 py-0.5 rounded">
                      <%= topic %>
                    </span>
                  <% end %>
                </div>
                <p class="text-[11px] text-gray-400 mt-2">
                  <%= feedback.source&.source_type || "Unknown" %> • <%= time_ago_in_words(feedback.created_at) %> ago
                </p>
              </div>
            </div>
          <% end %>
        </div>
        <%= link_to "View all", feedbacks_path, class: "text-indigo-600 hover:text-indigo-700 text-sm font-medium mt-4 inline-block" %>
      </div>

      <!-- Closed-Loop Tracker -->
      <div class="bg-white border border-gray-100 rounded-xl p-5">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-sm font-bold text-gray-900">Closed-Loop Tracker</h2>
          <span class="bg-indigo-100 text-indigo-700 text-[11px] font-bold px-2 py-1 rounded-full">NEW</span>
        </div>
        <div class="space-y-3">
          <% closed_loop_items = [
            { status: "shipped", title: "Dashboard Export", description: "CSV export feature shipped in v2.4", icon: "✅", icon_bg: "bg-emerald-50" },
            { status: "progress", title: "Auth Improvements", description: "SSO integration in progress", icon: "⚙️", icon_bg: "bg-blue-50" },
            { status: "planned", title: "Mobile App", description: "Planned for Q2 2026", icon: "📱", icon_bg: "bg-amber-50" }
          ] %>

          <% closed_loop_items.each do |item| %>
            <div class="flex gap-3 pb-3 border-b border-gray-100 last:border-0">
              <div class="w-7 h-7 rounded-full flex-shrink-0 flex items-center justify-center <%= item[:icon_bg] %> text-base">
                <%= item[:icon] %>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="text-sm font-semibold text-gray-900"><%= item[:title] %></h3>
                <p class="text-[12px] text-gray-500 mt-1"><%= item[:description] %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
